<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>UYÊN COFFEE POS PRO</title>
    <script src="https://www.gstatic.com/firebasejs/9.15.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.15.0/firebase-database-compat.js"></script>
    <style>
        :root {
            --primary: #5d3fd3;
            --primary-gradient: #5d3fd3;
            --success: #28a745;
            --success-gradient: #28a745;
            --danger: #dc3545;
            --danger-gradient: #dc3545;
            --dark: #2c3e50;
            --bg: #f8f9fa;
            --warning: #cca352;
            --glass-bg: #ffffff;
            --glass-border: #e0e0e0;
            --shadow-soft: none;
        }
        * { box-sizing: border-box; font-family: 'Segoe UI', system-ui, sans-serif; -webkit-tap-highlight-color: transparent; }

        body {
            margin: 0;
            background: var(--bg);
            height: 100vh; height: 100dvh; display: flex; flex-direction: column; overflow: hidden;
        }

        .navbar {
            position: relative; z-index: 1000000;
            background: #ffffff;
            padding: 12px 15px; display: flex; justify-content: space-between; align-items: center;
            border-bottom: 1px solid #ddd; flex-shrink: 0;
        }

        .nav-item { padding: 10px 16px; cursor: pointer; border-radius: 8px; font-size: 12px; font-weight: bold; background: #f0f0f0; border: none; }
        .nav-item.active { background: var(--primary); color: white; }

        .tab-content { display: none; flex: 1; overflow: hidden; position: relative; padding-bottom: 60px; }
        .tab-content.active { display: flex; }

        .tables-grid { flex: 1; display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 12px; padding: 15px; overflow-y: auto; align-content: start; }

        .order-container { display: flex; width: 100%; height: 100%; background: #ffffff; overflow: hidden; }

        .menu-container-flex { width: 55%; display: flex; background: #f4f6f8; overflow: hidden; }
        .category-sidebar { width: 85px; background: #ffffff; border-right: 1px solid #ddd; overflow-y: auto; display: flex; flex-direction: column; flex-shrink: 0; }
        .cat-btn { padding: 15px 5px; text-align: center; font-size: 12px; font-weight: bold; border-bottom: 1px solid #eee; cursor: pointer; color: var(--dark); transition: 0.2s; }
        .cat-btn.active { background: var(--primary); color: white; }
        .menu-part-items { flex: 1; overflow-y: auto; padding: 12px; scroll-behavior: smooth; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; align-content: start; }
        .cat-header { grid-column: 1 / -1; font-weight: bold; color: var(--dark); margin: 10px 0 5px 0; border-bottom: 2px solid var(--primary); padding-bottom: 5px; font-size: 15px; text-transform: uppercase; }

        .bill-part { width: 45%; display: flex; flex-direction: column; border-left: 1px solid #ddd; height: 100%; background: #ffffff; }
        .bill-items-area { flex: 1; overflow-y: auto; background: transparent; scroll-behavior: smooth; padding: 5px; }

        .pos-controls { padding: 12px; background: #f9f9f9; border-top: 1px solid #ddd; display: flex; flex-direction: column; gap: 8px; flex-shrink: 0; }

        .table-card {
            background: #ffffff; height: 105px;
            border: 1px solid var(--dark); border-radius: 8px;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            font-weight: bold; font-size: 11px; order: 2; cursor: pointer;
            color: var(--dark);
        }
        .table-card:active { transform: scale(0.95); }
        .table-card.status-red { border: 2px solid #dc3545; background: #ffb8c0; order: 1; }
        .table-card.status-green { border: 2px solid #28a745; background: #b8e6c1; order: 1; }

        .table-timer { font-size: 10px; margin-top: 2px; }

        .menu-item {
            background: #ffffff;
            border: 1px solid #c8d6e5;
            padding: 12px 8px;
            border-radius: 10px;
            text-align: center;
            font-weight: bold;
            font-size: 13px;
            cursor: pointer;
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 72px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.03);
            user-select: none;
            -webkit-user-select: none;
            transition: all 0.15s ease;
        }
        .menu-item * { pointer-events: none; }
        .menu-item:active { transform: scale(0.95); background: var(--primary); color: white; border-color: var(--primary); }
        .menu-item:active * { color: white !important; }
        .menu-item.sold-out { background: #e9ecef; border-color: #ced4da; color: #6c757d; cursor: not-allowed; }
        .menu-item.sold-out:active { transform: none; background: #e9ecef; color: #6c757d; }

        .bill-row { padding: 12px; border-bottom: 1px dashed rgba(0,0,0,0.1); display: flex; flex-direction: column; font-size: 13px; background: white; margin-bottom: 5px; border-radius: 8px; }
        .item-not-done { color: var(--danger); font-weight: bold; }

        .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 100000; align-items: center; justify-content: center; padding: 20px; }
        .modal { background: #ffffff; width: 100%; max-width: 350px; border-radius: 12px; padding: 25px; max-height: 85vh; overflow-y: auto; border: 1px solid #ddd; }

        .admin-section { background: #ffffff; padding: 18px; border-radius: 12px; margin-bottom: 18px; border: 1px solid #ddd; }
        .bill-history-card { background: #f9f9f9; padding: 15px; border-radius: 8px; border-left: 5px solid var(--primary); margin-bottom: 12px; font-size: 13px; border-right: 1px solid #ddd; border-top: 1px solid #ddd; border-bottom: 1px solid #ddd; }
        .shift-log-card { background: #f9f9f9; padding: 15px; border-radius: 8px; border-left: 5px solid var(--dark); margin-bottom: 12px; font-size: 13px; border-right: 1px solid #ddd; border-top: 1px solid #ddd; border-bottom: 1px solid #ddd; }

        .opt-btn { background: #fff; border: 1px solid #ddd; padding: 12px; border-radius: 10px; font-weight: bold; cursor: pointer; }
        .opt-btn.active { background: var(--primary); color: white; border: none; }

        .qr-image-display { width: 100%; max-width: 200px; margin: 15px auto; display: none; border-radius: 10px; }
        .detail-item { display: flex; justify-content: space-between; font-size: 12px; color: #555; margin-top: 4px; border-bottom: 1px dotted #ddd; padding-bottom: 4px; }

        #authOverlay { background: #f4f7f6; display: flex; flex-direction: column; z-index: 999999; }
        .auth-container { background: #ffffff; padding: 40px 25px; border-radius: 16px; width: 100%; max-width: 340px; text-align: center; border: 1px solid #ddd; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        .auth-input { width: 100%; padding: 15px; margin-bottom: 15px; border: 1px solid #ddd; border-radius: 10px; font-size: 14px; outline: none; background: #f9f9f9; }
        .auth-input:focus { border-color: var(--primary); background: #fff; }
        .dev-item { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px dashed #ddd; font-size: 13px; }

        .task-card { background: white; padding: 15px; border-radius: 8px; margin-bottom: 10px; display: flex; align-items: center; justify-content: space-between; border: 1px solid #ddd; }
        .task-text { font-size: 14px; transition: all 0.2s; }
        .task-important { color: var(--danger) !important; font-weight: bold; }
        .task-done-text { text-decoration: line-through; color: #aaa !important; font-weight: normal !important; }

        .mobile-bottom-nav { display: flex; position: fixed; bottom: 0; left: 0; width: 100%; height: 65px; background: #ffffff; border-top: 1px solid #ddd; z-index: 9999; padding-bottom: env(safe-area-inset-bottom); }
        .m-btn { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; font-size: 12px; color: #888; font-weight: bold; cursor: pointer; position: relative; }
        .m-btn.active { color: var(--primary); background: #f4f6f8; }
        .m-btn.active::after { content: ''; position: absolute; top: 0; left: 20%; width: 60%; height: 3px; background: var(--primary); border-radius: 0 0 3px 3px; }

        button { cursor: pointer; }
        button:active { transform: scale(0.97); }

        @media (max-width: 768px) {
            .menu-container-flex { width: 60%; }
            .bill-part { width: 40%; }
            .category-sidebar { width: 60px; }
            .cat-btn { padding: 12px 2px; font-size: 10px; word-break: break-word; }
            .menu-part-items { grid-template-columns: repeat(2, 1fr); gap: 8px; padding: 6px; }
            .menu-item { padding: 10px 5px; font-size: 12px; min-height: 68px; }
            .cat-header { font-size: 13px; margin: 5px 0; }
            #lblTable { font-size: 12px !important; }
            #lblTotal { font-size: 15px !important; }
            .bill-row { font-size: 11px; padding: 8px 5px; }
            .pos-controls { display: flex; flex-direction: column; padding: 8px; gap: 6px; }
            .pos-controls button { padding: 12px; font-size: 11px !important; margin: 0; }
        }
    </style>
</head>
<body>

<div id="authOverlay" class="modal-overlay">
    <div class="auth-container">
        <h2 style="color: var(--primary); margin-top: 0; font-weight: 800;">KÍCH HOẠT THIẾT BỊ</h2>
        <p style="font-size: 13px; color: gray; margin-bottom: 25px;">Vui lòng nhập mã đăng ký do quản lý cấp để sử dụng hệ thống.</p>
        <input type="text" id="regName" class="auth-input" placeholder="Tên nhân viên (VD: Lan Anh)">
        <input type="password" id="regPass" class="auth-input" placeholder="Tạo mật khẩu cá nhân">
        <input type="number" id="regCode" class="auth-input" placeholder="Mã đăng ký (5 số)" oninput="if(this.value.length > 5) this.value = this.value.slice(0,5);">
        <button onclick="registerDevice()" style="width: 100%; background: var(--primary-gradient); color: white; padding: 15px; border: none; border-radius: 10px; font-weight: bold; font-size: 15px;">ĐĂNG KÝ VÀ VÀO CA</button>
    </div>
</div>

<!-- PORTAL OVERLAY: LỰA CHỌN CỬA HÀNG / NHÂN VIÊN & ĐĂNG NHẬP / ĐĂNG KÝ -->
<div id="portalOverlay" class="modal-overlay" style="display:none; z-index:9999999; background:rgba(15,23,42,0.85); backdrop-filter:blur(6px);">
    <div class="auth-container" style="max-width:380px; width:92%; padding:30px 22px; position:relative;">
        <div style="text-align:center; margin-bottom:20px;">
            <div style="font-size:26px;">☕🏪</div>
            <h2 id="portalTitle" style="color:var(--primary); margin:6px 0 4px 0; font-weight:900; font-size:20px;">CHỌN VAI TRÒ TRUY CẬP</h2>
            <p id="portalSubtitle" style="font-size:12px; color:gray; margin:0;">Hệ thống POS Đa Cửa Hàng Chuyên Nghiệp</p>
        </div>

        <!-- Role Selector Tabs -->
        <div id="roleSelectTabs" style="display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:18px;">
            <button id="tabBtnStoreRole" onclick="selectPortalRole('store')" style="padding:12px 6px; border:2px solid var(--primary); border-radius:10px; background:var(--primary); color:white; font-weight:bold; font-size:13px; cursor:pointer;">🏪 CỬA HÀNG</button>
            <button id="tabBtnStaffRole" onclick="selectPortalRole('staff')" style="padding:12px 6px; border:2px solid #ddd; border-radius:10px; background:#fff; color:#555; font-weight:bold; font-size:13px; cursor:pointer;">👤 NHÂN VIÊN</button>
        </div>

        <!-- Sub Tabs (Login / Register) -->
        <div style="display:flex; border-bottom:2px solid #eee; margin-bottom:18px;">
            <button id="subTabBtnLogin" onclick="setPortalMode('login')" style="flex:1; padding:10px; border:none; background:none; font-weight:bold; font-size:13px; color:var(--primary); border-bottom:3px solid var(--primary); cursor:pointer;">ĐĂNG NHẬP</button>
            <button id="subTabBtnRegister" onclick="setPortalMode('register')" style="flex:1; padding:10px; border:none; background:none; font-weight:bold; font-size:13px; color:#888; cursor:pointer;">ĐĂNG KÝ MỚI</button>
        </div>

        <!-- Form 1: Cửa hàng Đăng nhập -->
        <div id="formStoreLogin">
            <input type="tel" id="storeLoginPhone" class="auth-input" placeholder="Số điện thoại chủ cửa hàng" autocomplete="tel">
            <input type="password" id="storeLoginPass" class="auth-input" placeholder="Mật khẩu cửa hàng">
            <button onclick="handleStoreLogin()" style="width:100%; background:var(--primary-gradient); color:white; padding:14px; border:none; border-radius:10px; font-weight:bold; font-size:14px; margin-bottom:10px;">VÀO CỬA HÀNG</button>
        </div>

        <!-- Form 2: Cửa hàng Đăng ký -->
        <div id="formStoreRegister" style="display:none;">
            <input type="text" id="storeRegName" class="auth-input" placeholder="Tên cửa hàng (VD: UYÊN COFFEE)">
            <input type="tel" id="storeRegPhone" class="auth-input" placeholder="Số điện thoại liên hệ">
            <input type="password" id="storeRegPass" class="auth-input" placeholder="Tạo mật khẩu gian hàng">
            <input type="text" id="storeRegActivationCode" class="auth-input" placeholder="Mã kích hoạt mở gian hàng">
            <button onclick="handleStoreRegister()" style="width:100%; background:var(--success-gradient); color:white; padding:14px; border:none; border-radius:10px; font-weight:bold; font-size:14px; margin-bottom:10px;">TẠO GIAN HÀNG MỚI</button>
        </div>

        <!-- Form 3: Nhân viên Đăng nhập -->
        <div id="formStaffLogin" style="display:none;">
            <input type="tel" id="staffLoginPhone" class="auth-input" placeholder="Số điện thoại nhân viên">
            <input type="password" id="staffLoginPass" class="auth-input" placeholder="Mật khẩu cá nhân">
            <button onclick="handleStaffLogin()" style="width:100%; background:var(--primary-gradient); color:white; padding:14px; border:none; border-radius:10px; font-weight:bold; font-size:14px; margin-bottom:10px;">ĐĂNG NHẬP VÀO CA</button>
        </div>

        <!-- Form 4: Nhân viên Đăng ký -->
        <div id="formStaffRegister" style="display:none;">
            <input type="text" id="staffRegName" class="auth-input" placeholder="Họ và tên nhân viên (VD: Lan Anh)">
            <input type="tel" id="staffRegPhone" class="auth-input" placeholder="Số điện thoại cá nhân">
            <input type="number" id="staffRegStoreId" class="auth-input" placeholder="Số thứ tự cửa hàng (VD: 1, 2...)">
            <input type="password" id="staffRegPass" class="auth-input" placeholder="Tạo mật khẩu cá nhân">
            <input type="text" id="staffRegCode" class="auth-input" placeholder="Mã đăng ký (do Quản lý cấp)">
            <button onclick="handleStaffRegister()" style="width:100%; background:var(--primary-gradient); color:white; padding:14px; border:none; border-radius:10px; font-weight:bold; font-size:14px; margin-bottom:10px;">ĐĂNG KÝ VÀ VÀO CA</button>
        </div>

        <!-- Chân trang: Mục nhỏ Quản lý hệ thống -->
        <div style="margin-top:16px; pt:12px; border-top:1px dashed #eee; text-align:center;">
            <button onclick="openSystemAdminLogin()" style="background:none; border:none; color:#888; font-size:12px; text-decoration:underline; cursor:pointer;">🛡️ Quản lý hệ thống</button>
        </div>
    </div>
</div>

<!-- MODAL: ĐĂNG NHẬP QUẢN TRỊ HỆ THỐNG TỔNG -->
<div id="systemAdminLoginModal" class="modal-overlay" style="display:none; z-index:99999999; background:rgba(0,0,0,0.85);">
    <div class="auth-container" style="max-width:340px; width:90%; padding:30px 22px;">
        <h3 style="margin-top:0; color:var(--dark); font-weight:800;">🛡️ QUẢN TRỊ HỆ THỐNG</h3>
        <p style="font-size:12px; color:gray; margin-bottom:20px;">Dành riêng cho Quản trị viên cấp cao</p>
        <input type="tel" id="sysAdminPhone" class="auth-input" placeholder="Số điện thoại quản trị">
        <input type="password" id="sysAdminPass" class="auth-input" placeholder="Mật khẩu quản trị">
        <input type="password" id="sysAdminSecurityCode" class="auth-input" placeholder="Mã bảo mật">
        <button onclick="handleSystemAdminLogin()" style="width:100%; background:var(--dark); color:white; padding:14px; border:none; border-radius:10px; font-weight:bold; font-size:14px; margin-bottom:10px;">ĐĂNG NHẬP HỆ THỐNG</button>
        <p onclick="closeModal('systemAdminLoginModal')" style="text-align:center; margin:10px 0 0 0; color:gray; cursor:pointer; font-weight:bold; font-size:13px;">Hủy / Đóng</p>
    </div>
</div>

<!-- MODAL: BẢNG ĐIỀU KHIỂN QUẢN TRỊ HỆ THỐNG TỔNG -->
<div id="systemAdminDashboardModal" class="modal-overlay" style="display:none; z-index:99999999; background:rgba(15,23,42,0.9);">
    <div style="background:#ffffff; border-radius:16px; width:95%; max-width:750px; max-height:90vh; overflow-y:auto; padding:24px; box-shadow:0 10px 25px rgba(0,0,0,0.2);">
        <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #ddd; padding-bottom:12px; margin-bottom:18px;">
            <div>
                <h2 style="margin:0; color:var(--dark); font-size:18px;">🛡️ QUẢN LÝ TỔNG HỆ THỐNG</h2>
                <span style="font-size:12px; color:gray;">Toàn quyền giám sát các cửa hàng & mã kích hoạt</span>
            </div>
            <button onclick="closeModal('systemAdminDashboardModal')" style="background:var(--danger); color:white; border:none; border-radius:8px; padding:8px 14px; font-weight:bold; font-size:12px;">ĐÓNG</button>
        </div>

        <!-- Khối mã kích hoạt hệ thống -->
        <div class="admin-section" style="background:#f8f9fa; border:1px solid #c7d2fe; border-radius:12px; padding:16px; margin-bottom:18px;">
            <h4 style="margin:0 0 6px 0; color:var(--primary); font-size:14px;">🔑 MÃ KÍCH HOẠT MỞ GIAN HÀNG MỚI</h4>
            <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;">
                <div>
                    Mã hiện tại: <b id="sysDisplayActivationCode" style="font-size:22px; color:var(--danger); letter-spacing:3px;">------</b>
                </div>
                <div style="display:flex; gap:8px;">
                    <button onclick="changeSystemActivationCode()" style="background:var(--primary); color:white; border:none; padding:10px 14px; border-radius:8px; font-size:12px; font-weight:bold;">🔄 ĐỔI MÃ KÍCH HOẠT</button>
                    <button onclick="copySystemActivationCode()" style="background:var(--dark); color:white; border:none; padding:10px 14px; border-radius:8px; font-size:12px; font-weight:bold;">📋 SAO CHÉP</button>
                </div>
            </div>
        </div>

        <!-- Khối danh sách cửa hàng -->
        <h4 style="margin:0 0 10px 0; color:var(--dark); font-size:15px;">🏪 TẤT CẢ CỬA HÀNG ĐANG HOẠT ĐỘNG (<span id="sysTotalStoresCount">0</span>)</h4>
        <div id="sysStoresListContainer" style="max-height:420px; overflow-y:auto; display:flex; flex-direction:column; gap:12px;">
            <div style="text-align:center; color:gray; padding:20px;">Đang tải dữ liệu cửa hàng...</div>
        </div>
    </div>
</div>

<div class="navbar">
    <div id="navStoreBrand" style="font-weight: 900; color: var(--primary); font-size: 17px; letter-spacing: 0.5px; display:flex; align-items:center; gap:6px;">
        <span id="navbarStoreName">UYÊN COFFEE</span>
        <span id="navbarStoreBadge" style="font-size:11px; background:#ede9fe; color:var(--primary); padding:2px 8px; border-radius:6px; font-weight:bold;">#1</span>
    </div>
    <div style="display:flex; gap:8px; align-items: center;">
        <div id="connectionStatusIndicator" class="nav-item" style="background: #f1f3f5; color: #495057; display: flex; align-items: center; gap: 6px; cursor: default; border: 1px solid #ced4da; padding: 8px 12px;">
            <span id="connDot" style="width: 9px; height: 9px; background: #ffc107; border-radius: 50%; display: inline-block;"></span>
            <span id="connText" style="font-size: 11px; font-weight: bold;">Kết nối...</span>
        </div>
        <button class="nav-item" onclick="showTab('tasks')">📋 VIỆC</button>
        <button class="nav-item" id="navAdminBtn" onclick="accessAdmin()">⚙️ QUẢN LÝ</button>
        <button class="nav-item" onclick="logoutCurrentSession()" title="Đăng xuất khỏi gian hàng" style="background:#fee2e2; color:var(--danger); border:1px solid #fca5a5; padding:8px 10px;">🚪</button>
    </div>
</div>

<div id="tab-tables" class="tab-content active" style="flex-direction: column;">
    <div id="table-subtabs" style="display: flex; background: #ffffff; border-bottom: 1px solid #ddd; flex-shrink: 0;">
        <button id="subtab-btn-tables" onclick="switchTableSubTab('tables')" style="flex:1; padding: 12px; border: none; background: transparent; font-weight: bold; font-size: 13px; cursor: pointer; border-bottom: 3px solid var(--primary); color: var(--primary);">🪑 Tất cả bàn</button>
        <button id="subtab-btn-bills" onclick="switchTableSubTab('bills')" style="flex:1; padding: 12px; border: none; background: transparent; font-weight: bold; font-size: 13px; cursor: pointer; color: #666;">🧾 Hóa đơn chưa thanh toán</button>
    </div>

    <div id="list-tables" class="tables-grid"></div>

    <div id="table-order-view" class="order-container" style="display: none; flex-direction: column;">
        <div id="order-top-header" style="background: var(--primary); color: white; padding: 12px 15px; display: flex; align-items: center; justify-content: space-between; font-weight: bold; font-size: 16px;">
            <div style="display: flex; align-items: center; gap: 8px;">
                <button onclick="closeTableOrderView()" style="background: transparent; color: white; border: none; font-size: 18px; cursor: pointer; padding: 0 5px;">←</button>
                <span id="orderHeaderTitle">BÀN 1 - MENU</span>
            </div>
            <div style="display: flex; align-items: center; gap: 10px;">
                <button onclick="deleteActiveTableBill()" style="background: rgba(220, 53, 69, 0.25); color: #fff; border: 1px solid rgba(255,255,255,0.4); padding: 4px 8px; border-radius: 6px; font-size: 14px; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 3px;" title="Xóa bill">🗑️</button>
                <button onclick="printTempBill()" style="background: rgba(255,255,255,0.2); color: white; border: 1px solid rgba(255,255,255,0.4); padding: 4px 8px; border-radius: 6px; font-size: 14px; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 3px;" title="In tạm tính">🖨️</button>
                <button onclick="openMoveTable()" style="background: rgba(255,255,255,0.2); color: white; border: 1px solid rgba(255,255,255,0.4); padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: bold;">CHUYỂN</button>
                <span style="font-size: 18px; cursor: pointer;" onclick="toggleOrderSubView()">⇆</span>
            </div>
        </div>

        <div id="order-summary-bar" style="background: #2c3e50; color: white; padding: 10px 15px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #1a252f;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="background: var(--primary); width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 16px;">🛒</div>
                <div>
                    <div id="lblTableSummary" style="font-size: 13px; font-weight: bold;">BÀN 1 (0 món)</div>
                    <div id="lblTotalSummary" style="color: #f39c12; font-weight: bold; font-size: 14px;">0đ</div>
                </div>
            </div>
            <button id="btnToggleOrderView" onclick="toggleOrderSubView()" style="background: transparent; color: white; border: none; font-size: 13px; font-weight: bold; cursor: pointer;">Xem đơn &gt;</button>
        </div>

        <div style="display: flex; flex: 1; overflow: hidden; position: relative;">
            <div id="menu-section-flex" class="menu-container-flex" style="width: 100%;">
                <div id="category-sidebar" class="category-sidebar"></div>
                <div id="list-menu" class="menu-part-items"></div>
            </div>

            <div id="bill-section-part" class="bill-part" style="width: 100%; display: none;">
                <div id="billItems" class="bill-items-area"></div>
                <div class="pos-controls">
                    <div style="display: flex; gap: 6px; width: 100%;">
                        <button onclick="handleConfirm()" style="flex: 1; background:var(--danger-gradient); color:white; border:none; padding:12px; border-radius:10px; font-weight:bold; font-size:12px;">XÁC NHẬN</button>
                        <button onclick="setStatus('green')" style="flex: 1; background:var(--success-gradient); color:white; border:none; padding:12px; border-radius:10px; font-weight:bold; font-size:12px;">XONG HẾT</button>
                        <button onclick="deleteActiveTableBill()" style="background:var(--danger); color:white; border:none; padding:12px 14px; border-radius:10px; font-weight:bold; font-size:14px; display:flex; align-items:center; justify-content:center;" title="Xóa bill">🗑️</button>
                    </div>
                    <button onclick="openPayModal()" style="width: 100%; background:var(--dark); color:white; border:none; padding:12px; border-radius:10px; font-weight:bold; font-size: 13px;">THANH TOÁN</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="tab-tasks" class="tab-content">
    <div style="padding:15px; width:100%; overflow-y:auto; padding-bottom:100px;">
        <div id="managerTaskArea" style="display: none;">
            <h2 style="color: var(--dark);">📋 Quản Lý Giao Việc</h2>

            <div class="admin-section">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <h3 style="margin:0;">Chọn nhân viên:</h3>
                    <button onclick="openTransferTaskModal()" style="background:var(--primary); color:white; border:none; padding:8px 12px; border-radius:8px; font-size:11px; font-weight:bold; cursor:pointer; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">🔄 NHẬN VIỆC TỪ...</button>
                </div>
                <select id="taskEmployeeSelect" onchange="loadTasksForManager()" style="width:100%; padding:14px; border-radius:10px; border:1px solid #ddd; font-weight:bold; outline:none; background: white;"></select>
            </div>

            <div class="admin-section">
                <h3 style="margin-top:0;">Thêm công việc mới</h3>
                <input type="text" id="taskContentInput" placeholder="Nhập tên việc cần làm..." style="width:100%; padding:14px; margin-bottom:12px; border:1px solid #ddd; border-radius:10px; background: white;">

                <select id="taskFrequency" style="width:100%; padding:14px; margin-bottom:12px; border:1px solid #ddd; border-radius:10px; font-weight:bold; background: white;">
                    <option value="0">Tần suất: Một lần (Không lặp lại)</option>
                    <option value="1">Tần suất: Hằng ngày</option>
                    <option value="2">Tần suất: 2 ngày / lần</option>
                    <option value="7">Tần suất: Hàng tuần</option>
                </select>

                <div style="display:flex; align-items:center; gap:8px; margin-bottom:15px; background:rgba(220, 53, 69, 0.05); padding: 10px; border-radius: 8px;">
                    <input type="checkbox" id="taskImportantInput" style="width:20px; height:20px; cursor:pointer;">
                    <label for="taskImportantInput" style="font-size:14px; font-weight:bold; color:var(--danger); cursor:pointer; margin:0;">Việc quan trọng (Luôn đỏ)</label>
                </div>
                <button onclick="addTaskByManager()" style="width:100%; padding:14px; background:var(--primary-gradient); color:white; border:none; border-radius:10px; font-weight:bold; cursor:pointer;">PHÂN VIỆC</button>
            </div>

            <div class="admin-section">
                <h3 style="margin-top:0;">Danh sách công việc đang giao</h3>
                <div id="managerTaskListContainer"></div>
            </div>
        </div>

        <div id="employeeTaskArea" style="display: none;">
            <h2 style="margin-bottom:5px; color: var(--dark);">📋 Công Việc Của Bạn</h2>
            <p style="font-size:13px; color:gray; margin-top:0; margin-bottom:20px;">Tích chọn vào ô vuông bên cạnh khi bạn đã hoàn thành công việc.</p>
            <div id="employeeTaskListContainer"></div>
        </div>
    </div>
</div>

<div id="tab-store" class="tab-content">
    <div style="padding:15px; width:100%; overflow-y:auto; padding-bottom:100px;">
        <h2 style="color: var(--dark);">🏪 Quản Lý Cửa Hàng</h2>

        <div class="admin-section">
            <h3 style="margin-top:0;">📦 Trạng Thái Ca Trong Ngày</h3>
            <div id="shiftSummary" style="margin-bottom:15px; padding:15px; background:#f9f9f9; border:1px solid #ddd; border-radius:10px; font-size:14px; line-height: 1.6;">Chưa mở ca</div>
            <button onclick="startShift()" id="btnOpen" style="width:100%;padding:14px;background:var(--success-gradient);color:white;border:none;border-radius:10px;font-weight:bold;">MỞ CA MỚI</button>
            <button onclick="endShift()" id="btnClose" style="width:100%;padding:14px;background:var(--danger-gradient);color:white;border:none;border-radius:10px;display:none;font-weight:bold;">CHỐT CA (ĐÓNG CA)</button>
        </div>

        <div class="admin-section" id="activeBillSection" style="display:none;">
            <h3 style="margin-top:0;">🧾 Bill Trong Ca Hiện Tại</h3>
            <div id="activeBillsList"></div>
        </div>

        <div class="admin-section" id="editHistorySection">
            <h3 style="margin-top:0; color: var(--dark);">📝 Lịch Sử Sửa / Xóa Hóa Đơn & Món</h3>
            <div id="editHistoryList" style="max-height: 350px; overflow-y: auto;">Chưa có lịch sử thay đổi</div>
        </div>

        <div class="admin-section">
            <h3 style="margin-top:0;">📝 Quản Lý Menu Món</h3>
            <input id="inCategory" placeholder="Nhóm món (VD: Cà phê, Sinh tố...)" style="width:100%;padding:14px;margin-bottom:8px;border:1px solid #ddd; border-radius: 10px; background: white;">
            <input id="inName" placeholder="Tên món" style="width:100%;padding:14px;margin-bottom:8px;border:1px solid #ddd; border-radius: 10px; background: white;">
            <input id="inPrice" type="number" placeholder="Giá" style="width:100%;padding:14px;margin-bottom:12px;border:1px solid #ddd; border-radius: 10px; background: white;">
            <div style="display:flex; align-items:center; gap:8px; margin-bottom:12px;">
                <input type="checkbox" id="inHasHotCold" checked style="width:20px; height:20px; cursor:pointer;">
                <label for="inHasHotCold" style="font-size:14px; font-weight:bold; cursor:pointer; margin:0;">Có chọn Nóng / Đá</label>
            </div>
            <button onclick="addMenu()" style="width:100%;padding:14px;background:var(--primary-gradient);color:white;border:none;border-radius:10px; font-weight: bold;">THÊM MÓN</button>
            <div id="adminMenu" style="margin-top:15px; max-height:300px; overflow-y:auto; padding-right: 5px;"></div>
        </div>

        <div class="admin-section" id="printKitchenSettingSection">
            <h3 style="margin-top:0;">🖨️ Cài Đặt In Phiếu Bếp (Xác Nhận Đơn)</h3>
            <p style="font-size:13px; color:#666; margin-top:0; margin-bottom:12px; line-height: 1.5;">
                Khi <b>BẬT (ON)</b>: Bấm "Xác nhận" sẽ gửi lệnh in món mới về máy in bếp.<br>
                Khi <b>TẮT (OFF)</b>: Bấm "Xác nhận" chỉ cập nhật món vào hệ thống, không gửi lệnh in về máy in giúp tiết kiệm giấy.
            </p>
            <div style="display:flex; align-items:center; justify-content:space-between; background:#f8f9fa; padding:12px 16px; border-radius:10px; border:1px solid #eee;">
                <div>
                    <span style="font-weight:bold; font-size:14px; color:var(--dark);">Trạng thái in phiếu order:</span>
                    <div id="kitchenPrintStatusText" style="font-size:12px; font-weight:bold; color:var(--success); margin-top:2px;">ĐANG BẬT IN (ON)</div>
                </div>
                <button id="btnToggleKitchenPrint" onclick="toggleKitchenPrint()" style="padding:10px 20px; font-size:14px; font-weight:bold; border:none; border-radius:8px; cursor:pointer; background:var(--success); color:white; transition: all 0.2s ease;">
                    BẬT (ON)
                </button>
            </div>
        </div>
    </div>
</div>

<div id="tab-admin" class="tab-content">
    <div style="padding:15px; width:100%; overflow-y:auto; padding-bottom:100px;">
        <h2 style="color: var(--dark);">Khu Vực Quản Lý Cửa Hàng</h2>

        <div class="admin-section">
            <h3 style="margin-top:0;">📱 Thiết Bị & Quyền</h3>
            <div id="deviceList" style="max-height: 250px; overflow-y: auto; margin-bottom: 15px; padding-right: 5px;"></div>

            <div style="background: rgba(248, 249, 255, 0.8); padding: 20px; border-radius: 12px; border: 1px dashed var(--primary); text-align: center;">
                <p style="margin: 0 0 8px 0; font-size: 13px; color: #555;">Mã đăng ký cấp cho nhân viên:</p>
                <b id="displayRegCode" style="font-size: 32px; color: var(--primary); letter-spacing: 6px; text-shadow: 1px 1px 2px rgba(0,0,0,0.1);">-----</b>
                <div style="margin-top: 15px; display: flex; gap: 10px; justify-content: center;">
                    <button onclick="generateNewCode()" style="flex:1; padding:12px; background:var(--warning); color:white; border:none; border-radius:8px; font-weight:bold; cursor:pointer;">MÃ MỚI</button>
                    <button onclick="copyCode()" style="flex:1; padding:12px; background:var(--dark); color:white; border:none; border-radius:8px; font-weight:bold; cursor:pointer;">SAO CHÉP</button>
                </div>
            </div>
        </div>

        <div class="admin-section">
            <h3 style="margin-top:0;">📊 Thống Kê Tổng Doanh Thu</h3>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:12px;">
                <input type="date" id="dateFrom" onchange="filterStats()" style="padding: 10px; border: 1px solid #ddd; border-radius: 8px; background: white;">
                <input type="date" id="dateTo" onchange="filterStats()" style="padding: 10px; border: 1px solid #ddd; border-radius: 8px; background: white;">
            </div>
            <div style="background: rgba(233, 236, 239, 0.8); padding:15px; border-radius:10px; font-size:18px; font-weight:bold; text-align: center;">
                Tổng lọc: <span id="statFiltered" style="color:var(--danger)">0đ</span>
            </div>
        </div>

        <div class="admin-section">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                <h3 style="margin: 0;">📜 Lịch Sử Ca Đã Chốt</h3>
                <button onclick="exportShiftLogs()" style="background:var(--success); color:white; border:none; padding:10px 15px; border-radius:8px; font-size:12px; font-weight:bold; cursor:pointer;">📥 TẢI EXCEL</button>
            </div>
            <div id="shiftLogsList" style="max-height: 400px; overflow-y: auto; padding-right: 5px;"></div>
        </div>

        <div class="admin-section">
            <h3 style="margin-top:0;">🖼️ Cài Đặt Tài Khoản QR</h3>
            <label style="font-size:12px; font-weight:bold; color:var(--dark);">Link ảnh QR Thanh Toán (Mặc định):</label>
            <input type="text" id="qrUrlInput" placeholder="Link ảnh QR..." style="width:100%;padding:12px;margin-bottom:12px;border:1px solid #ddd; border-radius: 10px; background: white;">
            <button onclick="saveQR()" style="width:100%;padding:14px;background:var(--dark);color:white;border:none;border-radius:10px; font-weight: bold;">LƯU QR</button>
        </div>



        <div class="admin-section">
            <h3 style="margin-top:0;">📊 Link Google Sheet Lưu Trữ Lịch Sử Chốt Ca</h3>
            <p style="font-size:12px; color:gray; margin-top:2px; margin-bottom:10px;">Dán URL Google Apps Script Web App (chốt ca sẽ tự động gửi số liệu doanh thu vào bảng tính này):</p>
            <input type="text" id="googleSheetUrlInput" placeholder="https://script.google.com/macros/s/.../exec" style="width:100%;padding:12px;margin-bottom:12px;border:1px solid #ddd; border-radius: 10px; background: white;">
            <button onclick="saveGoogleSheetUrl()" style="width:100%;padding:14px;background:var(--success);color:white;border:none;border-radius:10px; font-weight: bold;">LƯU LINK GOOGLE SHEET</button>
        </div>
    </div>
</div>

<div id="transferTaskModal" class="modal-overlay">
    <div class="modal">
        <h3 style="margin-top:0; color: var(--dark);">Nhận việc từ nhân viên khác</h3>
        <p style="font-size: 13px; color: gray;">Toàn bộ công việc của nhân viên được chọn sẽ bị xóa và bốc qua giao cho: <b id="transferTargetName" style="color:var(--primary)">...</b></p>
        <select id="transferSourceSelect" style="width:100%; padding:15px; margin-bottom:20px; border-radius:10px; border:2px solid var(--primary); background:white; font-size:14px; font-weight:bold;"></select>
        <button onclick="executeTaskTransfer()" style="width:100%; background:var(--primary-gradient); color:white; padding:15px; border:none; border-radius:10px; font-weight:bold; margin-bottom: 10px;">XÁC NHẬN CHUYỂN</button>
        <p onclick="closeModal('transferTaskModal')" style="text-align:center; margin-top:5px; color:gray; cursor:pointer; font-weight:bold;">Hủy</p>
    </div>
</div>

<div id="editMenuModal" class="modal-overlay">
    <div class="modal">
        <h3 style="margin-top:0; color: var(--dark);">Sửa thông tin món</h3>
        <input type="hidden" id="editMenuKey">
        <input id="editMenuCategory" placeholder="Nhóm món (VD: Cà phê)" class="auth-input">
        <input id="editMenuName" placeholder="Tên món" class="auth-input">
        <input id="editMenuPrice" type="number" placeholder="Giá" class="auth-input">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:15px;">
            <input type="checkbox" id="editMenuHasHotCold" style="width:20px; height:20px; cursor:pointer;">
            <label for="editMenuHasHotCold" style="font-size:14px; font-weight:bold; cursor:pointer; margin:0;">Có chọn Nóng / Đá</label>
        </div>
        <button onclick="saveEditMenu()" style="width:100%; background:var(--primary-gradient); color:white; padding:15px; border:none; border-radius:10px; font-weight:bold;">LƯU THAY ĐỔI</button>
        <p onclick="closeModal('editMenuModal')" style="text-align:center; margin-top:15px; color:gray; cursor:pointer; font-weight:bold;">Hủy</p>
    </div>
</div>

<div id="payModal" class="modal-overlay">
    <div class="modal">
        <h3 style="margin-top:0; color: var(--dark);">Thanh toán</h3>
        <div style="font-size:22px; margin-bottom:15px; text-align: center;">Tổng: <b id="payTotal" style="color:var(--danger)">0</b></div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:20px;">
            <button id="payCashBtn" class="opt-btn" onclick="setPayMethod('cash')">TIỀN MẶT</button>
            <button id="payTransferBtn" class="opt-btn" onclick="setPayMethod('transfer')">CHUYỂN KHOẢN</button>
        </div>
        <div id="cashSection">
            <input type="number" id="cashIn" placeholder="Khách đưa..." style="width:100%; padding:18px; border:2px solid var(--primary); border-radius:12px; font-size: 16px; background: white;" oninput="calcChange()">
            <div style="margin:20px 0; font-size:20px; text-align: center;">Thối: <b id="cashChange" style="color:var(--success)">0đ</b></div>
        </div>
        <div id="transferSection" style="display:none; text-align:center;">
            <img id="qrDisplay" class="qr-image-display" src="">
        </div>
        <button onclick="handlePay(false)" style="width:100%; background:var(--dark); color:white; padding:14px; border:none; border-radius:12px; font-weight:bold; font-size: 14px; margin-bottom: 8px;">KHÔNG IN HĐ</button>
        <button onclick="handlePay(true)" style="width:100%; background:var(--primary-gradient); color:white; padding:14px; border:none; border-radius:12px; font-weight:bold; font-size: 14px;">IN HĐ</button>
        <p onclick="closeModal('payModal')" style="text-align:center; margin-top:15px; color:gray; cursor:pointer; font-weight: bold;">Hủy</p>
    </div>
</div>

<div id="optModal" class="modal-overlay"><div class="modal"><h3 id="optTitle" style="margin-top:0; color:var(--dark); text-align:center;"></h3><div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:15px;"><button id="optNong" class="opt-btn" onclick="curType='Nóng'; updateOptUI()">NÓNG</button><button id="optDa" class="opt-btn" onclick="curType='Đá'; updateOptUI()">ĐÁ</button></div><input id="optNote" placeholder="Ghi chú..." style="width:100%; padding:15px; border:1px solid #ddd; border-radius:10px; margin-bottom:20px; background:white;"><button onclick="confirmAdd()" style="width:100%; background:var(--primary-gradient); color:white; padding:15px; border:none; border-radius:10px; font-weight:bold;">THÊM VÀO ĐƠN</button><p onclick="closeModal('optModal')" style="text-align:center; margin-top:15px; color:gray; cursor:pointer; font-weight:bold;">Hủy</p></div></div>
<div id="qtyModal" class="modal-overlay"><div class="modal"><h3 style="margin-top:0;">Sửa món</h3><p id="qtyName" style="font-weight:bold; color:var(--primary); font-size:16px; text-align:center;"></p><div style="display:flex; justify-content:center; align-items:center; gap:20px; margin:20px 0;"><button class="opt-btn" style="width:60px; height:60px; font-size:24px; border-radius:15px;" onclick="changeQty(-1)">-</button><b id="qtyVal" style="font-size:35px; width: 40px; text-align:center;">1</b><button class="opt-btn" style="width:60px; height:60px; font-size:24px; border-radius:15px;" onclick="changeQty(1)">+</button></div><input id="editItemNote" placeholder="Thêm ghi chú món..." style="width:100%; padding:14px; border:1px solid #ddd; border-radius:10px; margin-bottom:15px; background:white;"><button onclick="saveItemEdit()" style="width:100%; background:var(--primary-gradient); color:white; padding:15px; border:none; border-radius:10px; font-weight:bold; margin-bottom:12px;">LƯU</button><button id="btnItemDone" onclick="toggleItemDone()" style="width:100%; background:var(--success-gradient); color:white; padding:15px; border:none; border-radius:10px; font-weight:bold;">XONG</button><p onclick="closeModal('qtyModal')" style="text-align:center; margin-top:15px; color:gray; cursor:pointer; font-weight:bold;">Đóng</p></div></div>

<div id="moveTableModal" class="modal-overlay">
    <div class="modal">
        <h3 id="moveModalTitle" style="margin-top:0;">Chuyển / Gộp bàn</h3>
        <p>Thao tác cho bàn <b id="moveFrom">?</b>:</p>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:15px;">
            <button id="modeMoveBtn" class="opt-btn active" onclick="setMoveMode('move')">CHUYỂN BÀN</button>
            <button id="modeMergeBtn" class="opt-btn" onclick="setMoveMode('merge')">GỘP BÀN</button>
        </div>

        <select id="selectToTable" style="width:100%; padding:15px; margin-bottom:20px; border-radius:10px; border:2px solid var(--primary); background:white; font-size:15px; font-weight:bold;"></select>

        <button onclick="handleMoveOrMergeTable()" style="width:100%; background:var(--primary-gradient); color:white; padding:15px; border:none; border-radius:10px; font-weight:bold;">XÁC NHẬN</button>
        <p onclick="closeModal('moveTableModal')" style="text-align:center; margin-top:15px; color:gray; cursor:pointer; font-weight:bold;">Hủy</p>
    </div>
</div>

<div id="serveModal" class="modal-overlay">
    <div class="modal" style="text-align:center;">
        <h3 style="margin-top:0;">Báo Bưng Nước Bàn <span id="serveTableId" style="color:var(--danger)"></span></h3>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:25px;">
            <button onclick="setServeStatus(true)" style="background:var(--danger-gradient); color:white; padding:16px; border:none; border-radius:10px; font-weight:bold; cursor:pointer;">RA MÓN</button>
            <button onclick="setServeStatus(false)" style="background:white; color:black; border:2px solid #ddd; padding:16px; border-radius:10px; font-weight:bold; cursor:pointer;">TRỐNG</button>
        </div>
        <p onclick="closeModal('serveModal')" style="margin-top:20px; color:gray; cursor:pointer; font-weight:bold;">Hủy</p>
    </div>
</div>

<div class="mobile-bottom-nav">
    <div class="m-btn active" id="btn-tab-tables" onclick="showTab('tables')">🪑 BÀN</div>
    <div class="m-btn" id="btn-tab-store" onclick="showTab('store')">🏪 CỬA HÀNG</div>
</div>

<script>
    const firebaseConfig = {
        apiKey: "AIzaSyCY23UN98357R178ZCxY9BhoTiX3LTzaQ8",
        authDomain: "uyencoffeepos.firebaseapp.com",
        databaseURL: "https://uyencoffeepos-default-rtdb.asia-southeast1.firebasedatabase.app",
        projectId: "uyencoffeepos",
        storageBucket: "uyencoffeepos.firebasestorage.app",
        messagingSenderId: "320504505998",
        appId: "1:320504505998:web:267ba0c6e8a283b4dd8bdf"
    };
    firebase.initializeApp(firebaseConfig);
    const db = firebase.database();

    db.ref('.info/connected').on('value', function(snapshot) {
        const dot = document.getElementById('connDot');
        const text = document.getElementById('connText');
        const indicator = document.getElementById('connectionStatusIndicator');
        if (snapshot.val() === true) {
            if (dot) { dot.style.background = '#28a745'; }
            if (text) { text.innerText = 'Mạng Tốt'; text.style.color = '#28a745'; }
            if (indicator) { indicator.style.borderColor = '#28a745'; indicator.style.background = '#e8f5e9'; }
        } else {
            if (dot) { dot.style.background = '#dc3545'; }
            if (text) { text.innerText = 'Mất Mạng / Yếu'; text.style.color = '#dc3545'; }
            if (indicator) { indicator.style.borderColor = '#dc3545'; indicator.style.background = '#f8d7da'; }
        }
    });

    let currentTab = 'tables';
    let curTable = null, menuData = {}, tablesData = {}, currentShift = null, curType = 'Đá', tempItem = null, editIdx = null, payMethod = 'cash', qrUrl = "";
    let currentMoveMode = 'move';

    let currentRegCode = "";
    let isAdmin = false;
    let allDevicesData = {};

    // --- MULTI-STORE ENGINE & SESSION STATE ---
    let currentStoreId = 1;
    let currentStoreData = null;
    let currentGoogleSheetUrl = "";
    let currentPortalRole = 'store'; // 'store' | 'staff'
    let currentPortalMode = 'login'; // 'login' | 'register'
    let storeListenersAttached = false;
    let attachedListeners = []; // Track listeners to cleanly detach if switching stores

    function storeRef(path) {
        if (!path) return db.ref();
        const cleanPath = path.replace(/^\/+/, '');
        const parts = cleanPath.split('/');
        const rootNode = parts[0];
        const rest = parts.slice(1).join('/');

        // Special system-wide nodes that don't belong to a specific store
        if (rootNode === 'settings' && (parts[1] === 'stores' || parts[1] === 'system')) {
            return db.ref(cleanPath);
        }

        const sid = currentStoreId || 1;
        const targetPath = `${rootNode}/store_${sid}${rest ? '/' + rest : ''}`;
        return db.ref(targetPath);
    }

    function storeUpdate(updates) {
        if (!updates || Object.keys(updates).length === 0) return Promise.resolve();
        const sid = currentStoreId || 1;
        let scopedUpdates = {};
        Object.keys(updates).forEach(key => {
            const cleanKey = key.replace(/^\/+/, '');
            const parts = cleanKey.split('/');
            const rootNode = parts[0];
            const rest = parts.slice(1).join('/');

            if (rootNode === 'settings' && (parts[1] === 'stores' || parts[1] === 'system')) {
                scopedUpdates[cleanKey] = updates[key];
            } else {
                scopedUpdates[`${rootNode}/store_${sid}${rest ? '/' + rest : ''}`] = updates[key];
            }
        });
        return db.ref().update(scopedUpdates);
    }

    // Portal Role & Tab Navigation
    function selectPortalRole(role) {
        currentPortalRole = role;
        const btnStore = document.getElementById('tabBtnStoreRole');
        const btnStaff = document.getElementById('tabBtnStaffRole');
        if (role === 'store') {
            btnStore.style.background = 'var(--primary)';
            btnStore.style.color = 'white';
            btnStore.style.borderColor = 'var(--primary)';
            btnStaff.style.background = '#fff';
            btnStaff.style.color = '#555';
            btnStaff.style.borderColor = '#ddd';
        } else {
            btnStaff.style.background = 'var(--primary)';
            btnStaff.style.color = 'white';
            btnStaff.style.borderColor = 'var(--primary)';
            btnStore.style.background = '#fff';
            btnStore.style.color = '#555';
            btnStore.style.borderColor = '#ddd';
        }
        updatePortalForms();
    }

    function setPortalMode(mode) {
        currentPortalMode = mode;
        const btnLogin = document.getElementById('subTabBtnLogin');
        const btnReg = document.getElementById('subTabBtnRegister');
        if (mode === 'login') {
            btnLogin.style.color = 'var(--primary)';
            btnLogin.style.borderBottom = '3px solid var(--primary)';
            btnReg.style.color = '#888';
            btnReg.style.borderBottom = 'none';
        } else {
            btnReg.style.color = 'var(--primary)';
            btnReg.style.borderBottom = '3px solid var(--primary)';
            btnLogin.style.color = '#888';
            btnLogin.style.borderBottom = 'none';
        }
        updatePortalForms();
    }

    function updatePortalForms() {
        document.getElementById('formStoreLogin').style.display = (currentPortalRole === 'store' && currentPortalMode === 'login') ? 'block' : 'none';
        document.getElementById('formStoreRegister').style.display = (currentPortalRole === 'store' && currentPortalMode === 'register') ? 'block' : 'none';
        document.getElementById('formStaffLogin').style.display = (currentPortalRole === 'staff' && currentPortalMode === 'login') ? 'block' : 'none';
        document.getElementById('formStaffRegister').style.display = (currentPortalRole === 'staff' && currentPortalMode === 'register') ? 'block' : 'none';
    }

    function showPortalOverlay() {
        document.getElementById('portalOverlay').style.display = 'flex';
    }

    function hidePortalOverlay() {
        document.getElementById('portalOverlay').style.display = 'none';
    }

    // Handlers for Store & Staff Auth
    function handleStoreLogin() {
        const phone = document.getElementById('storeLoginPhone').value.trim();
        const pass = document.getElementById('storeLoginPass').value.trim();
        if (!phone || !pass) return alert("Vui lòng nhập đầy đủ Số điện thoại và Mật khẩu!");

        db.ref('settings/stores').once('value').then(snapshot => {
            const stores = snapshot.val() || {};
            let matchedStore = null;
            Object.keys(stores).forEach(sId => {
                const s = stores[sId];
                if (s && s.phone === phone && s.password === pass) {
                    matchedStore = { ...s, id: parseInt(sId) || s.id };
                }
            });

            if (!matchedStore) {
                return alert("Số điện thoại hoặc Mật khẩu không chính xác!");
            }

            // Save session
            const session = {
                role: 'Quản lý',
                isOwner: true,
                storeId: matchedStore.id,
                storeName: matchedStore.name,
                phone: matchedStore.phone,
                userName: matchedStore.name,
                devId: 'OWNER_' + matchedStore.id,
                devPass: pass
            };
            localStorage.setItem('uc_session', JSON.stringify(session));
            localStorage.setItem('uc_dev_id', session.devId);
            localStorage.setItem('uc_dev_pass', pass);

            applySession(session);
        }).catch(err => {
            alert("Lỗi kết nối kiểm tra tài khoản: " + err.message);
        });
    }

    function handleStoreRegister() {
        const name = document.getElementById('storeRegName').value.trim();
        const phone = document.getElementById('storeRegPhone').value.trim();
        const pass = document.getElementById('storeRegPass').value.trim();
        const actCode = document.getElementById('storeRegActivationCode').value.trim();

        if (!name || !phone || !pass || !actCode) {
            return alert("Vui lòng điền đầy đủ tất cả thông tin!");
        }

        // Verify activation code
        db.ref('settings/system').once('value').then(sysSnap => {
            const sys = sysSnap.val() || {};
            const correctCode = sys.activationCode || "888999";
            if (actCode !== correctCode) {
                return alert("Mã kích hoạt không chính xác hoặc đã được đổi!");
            }

            // Check if phone already registered
            db.ref('settings/stores').once('value').then(storesSnap => {
                const stores = storesSnap.val() || {};
                let phoneExists = false;
                let maxId = 1;
                Object.keys(stores).forEach(k => {
                    const s = stores[k];
                    if (s && s.phone === phone) phoneExists = true;
                    const numericId = parseInt(k) || (s && s.id) || 1;
                    if (numericId > maxId) maxId = numericId;
                });

                if (phoneExists) {
                    return alert("Số điện thoại này đã đăng ký cửa hàng trong hệ thống!");
                }

                const newStoreId = maxId + 1;
                const newStoreData = {
                    id: newStoreId,
                    name: name,
                    phone: phone,
                    password: pass,
                    createdAt: new Date().toLocaleString('vi-VN'),
                    googleSheetUrl: ""
                };

                // Save store info & initialize clean store settings
                Promise.all([
                    db.ref('settings/stores/' + newStoreId).set(newStoreData),
                    db.ref('settings/store_' + newStoreId + '/regCode').set(Math.floor(10000 + Math.random() * 90000).toString()),
                    db.ref('settings/store_' + newStoreId + '/kitchenOrderPrint').set(false)
                ]).then(() => {
                    alert(`Chúc mừng! Gian hàng "${name}" đã tạo thành công với Số thứ tự: ${newStoreId}.\nBạn sẽ được chuyển vào ứng dụng ngay bây giờ.`);
                    const session = {
                        role: 'Quản lý',
                        isOwner: true,
                        storeId: newStoreId,
                        storeName: name,
                        phone: phone,
                        userName: name,
                        devId: 'OWNER_' + newStoreId,
                        devPass: pass
                    };
                    localStorage.setItem('uc_session', JSON.stringify(session));
                    localStorage.setItem('uc_dev_id', session.devId);
                    localStorage.setItem('uc_dev_pass', pass);
                    applySession(session);
                }).catch(err => {
                    alert("Lỗi khi tạo gian hàng: " + err.message);
                });
            });
        }).catch(err => {
            alert("Lỗi kết nối hệ thống: " + err.message);
        });
    }

    function handleStaffLogin() {
        const phone = document.getElementById('staffLoginPhone').value.trim();
        const pass = document.getElementById('staffLoginPass').value.trim();
        if (!phone || !pass) return alert("Vui lòng nhập Số điện thoại và Mật khẩu!");

        // Search through stores to find device with this phone and password
        db.ref('settings/stores').once('value').then(storesSnap => {
            const stores = storesSnap.val() || {};
            const storeIds = Object.keys(stores);

            if (storeIds.length === 0) return alert("Không tìm thấy cửa hàng nào trong hệ thống!");

            let checkPromises = storeIds.map(sId => {
                return db.ref(`devices/store_${sId}`).once('value').then(devSnap => {
                    const devs = devSnap.val() || {};
                    let matchedDev = null;
                    Object.keys(devs).forEach(devId => {
                        const d = devs[devId];
                        if (d && (d.phone === phone || d.name === phone) && d.password === pass) {
                            matchedDev = { ...d, devId: devId, storeId: parseInt(sId) };
                        }
                    });
                    return matchedDev;
                });
            });

            Promise.all(checkPromises).then(results => {
                const found = results.find(r => r !== null);
                if (!found) {
                    return alert("Số điện thoại hoặc Mật khẩu nhân viên không chính xác!");
                }

                const storeInfo = stores[found.storeId] || { name: 'Cửa hàng #' + found.storeId };
                const session = {
                    role: found.role || 'Phục vụ',
                    isOwner: false,
                    storeId: found.storeId,
                    storeName: storeInfo.name,
                    phone: phone,
                    userName: found.name,
                    devId: found.devId,
                    devPass: pass
                };
                localStorage.setItem('uc_session', JSON.stringify(session));
                localStorage.setItem('uc_dev_id', session.devId);
                localStorage.setItem('uc_dev_pass', pass);
                applySession(session);
            });
        }).catch(err => {
            alert("Lỗi kiểm tra nhân viên: " + err.message);
        });
    }

    function handleStaffRegister() {
        const name = document.getElementById('staffRegName').value.trim();
        const phone = document.getElementById('staffRegPhone').value.trim();
        const storeIdInput = parseInt(document.getElementById('staffRegStoreId').value.trim());
        const pass = document.getElementById('staffRegPass').value.trim();
        const code = document.getElementById('staffRegCode').value.trim();

        if (!name || !phone || isNaN(storeIdInput) || !pass || !code) {
            return alert("Vui lòng điền đầy đủ tất cả thông tin đăng ký nhân viên!");
        }

        // Verify store existence and regCode
        Promise.all([
            db.ref('settings/stores/' + storeIdInput).once('value'),
            db.ref('settings/store_' + storeIdInput + '/regCode').once('value')
        ]).then(([storeSnap, codeSnap]) => {
            const store = storeSnap.val();
            if (!store) {
                return alert(`Không tìm thấy cửa hàng số thứ tự #${storeIdInput}! Vui lòng kiểm tra lại.`);
            }

            const currentCode = String(codeSnap.val() || "");
            if (code !== currentCode) {
                return alert("Mã đăng ký không chính xác hoặc đã được quản lý đổi mới!");
            }

            const newDevId = 'DEV_' + Date.now();
            const devData = {
                name: name,
                phone: phone,
                password: pass,
                role: 'Phục vụ',
                createdAt: new Date().toLocaleString('vi-VN')
            };

            db.ref(`devices/store_${storeIdInput}/${newDevId}`).set(devData).then(() => {
                alert(`Đăng ký thành công nhân viên "${name}" vào cửa hàng "${store.name}" (#${storeIdInput})!\nQuyền mặc định là Phục vụ.`);
                const session = {
                    role: 'Phục vụ',
                    isOwner: false,
                    storeId: storeIdInput,
                    storeName: store.name,
                    phone: phone,
                    userName: name,
                    devId: newDevId,
                    devPass: pass
                };
                localStorage.setItem('uc_session', JSON.stringify(session));
                localStorage.setItem('uc_dev_id', session.devId);
                localStorage.setItem('uc_dev_pass', pass);
                applySession(session);
            }).catch(err => {
                alert("Lỗi lưu tài khoản nhân viên: " + err.message);
            });
        }).catch(err => {
            alert("Lỗi kết nối kiểm tra: " + err.message);
        });
    }

    function logoutCurrentSession() {
        if (!confirm("Bạn có chắc chắn muốn đăng xuất khỏi gian hàng này?")) return;
        localStorage.removeItem('uc_session');
        localStorage.removeItem('uc_dev_id');
        localStorage.removeItem('uc_dev_pass');
        location.reload();
    }

    // --- SYSTEM ADMIN SUPER PANEL ---
    function openSystemAdminLogin() {
        document.getElementById('systemAdminLoginModal').style.display = 'flex';
    }

    function handleSystemAdminLogin() {
        const phone = document.getElementById('sysAdminPhone').value.trim();
        const pass = document.getElementById('sysAdminPass').value.trim();
        const secCode = document.getElementById('sysAdminSecurityCode').value.trim();

        if (phone === "0946327164" && pass === "Sang19052005##" && secCode === "1905") {
            closeModal('systemAdminLoginModal');
            openSystemAdminDashboard();
        } else {
            alert("Thông tin quản trị hệ thống không chính xác!");
        }
    }

    function openSystemAdminDashboard() {
        document.getElementById('systemAdminDashboardModal').style.display = 'flex';
        loadSystemAdminData();
    }

    function loadSystemAdminData() {
        // Load activation code
        db.ref('settings/system').once('value').then(sysSnap => {
            const sys = sysSnap.val() || {};
            const code = sys.activationCode || "888999";
            document.getElementById('sysDisplayActivationCode').innerText = code;
        });

        // Load all stores
        const container = document.getElementById('sysStoresListContainer');
        container.innerHTML = '<div style="text-align:center; color:gray; padding:20px;">Đang tính toán doanh thu các cửa hàng...</div>';

        db.ref('settings/stores').once('value').then(storesSnap => {
            const stores = storesSnap.val() || {};
            const storeIds = Object.keys(stores);
            document.getElementById('sysTotalStoresCount').innerText = storeIds.length;

            if (storeIds.length === 0) {
                container.innerHTML = '<p style="color:gray; text-align:center;">Chưa có cửa hàng nào được ghi nhận.</p>';
                return;
            }

            let revenuePromises = storeIds.map(sId => {
                const s = stores[sId];
                return Promise.all([
                    db.ref(`shift_logs/store_${sId}`).once('value'),
                    db.ref(`active_shift/store_${sId}`).once('value')
                ]).then(([shiftLogsSnap, activeShiftSnap]) => {
                    let totalRev = 0;
                    const shiftLogs = shiftLogsSnap.val() || {};
                    Object.values(shiftLogs).forEach(log => {
                        totalRev += (log.revenue || 0);
                    });
                    const activeShift = activeShiftSnap.val();
                    if (activeShift && activeShift.revenue) {
                        totalRev += (activeShift.revenue || 0);
                    }
                    return {
                        id: parseInt(sId) || s.id,
                        name: s.name || 'Chưa đặt tên',
                        phone: s.phone || 'Chưa có SĐT',
                        createdAt: s.createdAt || 'N/A',
                        revenue: totalRev,
                        data: s
                    };
                });
            });

            Promise.all(revenuePromises).then(storeDataList => {
                storeDataList.sort((a,b) => a.id - b.id);
                container.innerHTML = '';
                storeDataList.forEach(st => {
                    const card = document.createElement('div');
                    card.className = 'admin-section';
                    card.style.cssText = 'background:#fdfdfe; border:1px solid #e2e8f0; border-radius:10px; padding:15px; margin-bottom:10px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;';
                    card.innerHTML = `
                        <div>
                            <div style="display:flex; align-items:center; gap:8px;">
                                <b style="font-size:16px; color:var(--dark);">${st.name}</b>
                                <span style="background:var(--primary); color:white; font-size:11px; padding:2px 8px; border-radius:6px; font-weight:bold;">STT: #${st.id}</span>
                            </div>
                            <div style="font-size:12px; color:#555; margin-top:4px;">
                                📞 SĐT: <b>${st.phone}</b> | 📅 Tạo lúc: ${st.createdAt}
                            </div>
                            <div style="font-size:13px; color:var(--danger); font-weight:bold; margin-top:6px;">
                                💰 Tổng doanh thu: ${st.revenue.toLocaleString()}đ
                            </div>
                        </div>
                        <div>
                            <button onclick="accessStoreDirectly(${st.id}, '${st.name.replace(/'/g, "\\'")}', '${st.phone}')" style="background:var(--primary-gradient); color:white; border:none; padding:10px 16px; border-radius:8px; font-weight:bold; font-size:13px; cursor:pointer;">
                                🚀 Truy cập vào cửa hàng
                            </button>
                        </div>
                    `;
                    container.appendChild(card);
                });
            });
        }).catch(err => {
            container.innerHTML = '<p style="color:red; text-align:center;">Lỗi tải cửa hàng: ' + err.message + '</p>';
        });
    }

    function changeSystemActivationCode() {
        const newCode = prompt("Nhập mã kích hoạt mở gian hàng mới (hoặc bấm OK để tạo mã 6 số ngẫu nhiên):");
        if (newCode === null) return;
        let finalCode = newCode.trim();
        if (!finalCode) {
            finalCode = Math.floor(100000 + Math.random() * 900000).toString();
        }
        db.ref('settings/system').update({
            activationCode: finalCode,
            updatedAt: new Date().toLocaleString('vi-VN')
        }).then(() => {
            document.getElementById('sysDisplayActivationCode').innerText = finalCode;
            alert("Đã cập nhật mã kích hoạt thành công: " + finalCode);
        }).catch(err => {
            alert("Lỗi đổi mã: " + err.message);
        });
    }

    function copySystemActivationCode() {
        const code = document.getElementById('sysDisplayActivationCode').innerText;
        navigator.clipboard.writeText(code).then(() => {
            alert("Đã sao chép mã kích hoạt: " + code);
        }).catch(() => {
            alert("Mã: " + code);
        });
    }

    function accessStoreDirectly(storeId, storeName, phone) {
        if (!confirm(`Xác nhận truy cập vào "${storeName}" (#${storeId}) với quyền Quản lý?`)) return;
        const session = {
            role: 'Quản lý',
            isOwner: true,
            storeId: storeId,
            storeName: storeName,
            phone: phone,
            userName: 'Admin Tổng (' + storeName + ')',
            devId: 'SUPER_ADMIN_' + storeId,
            devPass: 'root'
        };
        localStorage.setItem('uc_session', JSON.stringify(session));
        localStorage.setItem('uc_dev_id', session.devId);
        localStorage.setItem('uc_dev_pass', session.devPass);
        closeModal('systemAdminDashboardModal');
        applySession(session);
    }

    // Apply active store session
    function applySession(session) {
        currentStoreId = session.storeId;
        isAdmin = (session.role === 'Quản lý' || session.isOwner);

        // Update brand in navbar
        const brandName = document.getElementById('navbarStoreName');
        const brandBadge = document.getElementById('navbarStoreBadge');
        if (brandName) brandName.innerText = session.storeName || 'UYÊN COFFEE';
        if (brandBadge) brandBadge.innerText = '#' + currentStoreId;

        // Hide portal overlay
        hidePortalOverlay();
        const authOv = document.getElementById('authOverlay');
        if (authOv) authOv.style.display = 'none';

        // Load store info & Google Sheet link
        db.ref('settings/stores/' + currentStoreId).once('value').then(snap => {
            currentStoreData = snap.val() || {};
            currentGoogleSheetUrl = currentStoreData.googleSheetUrl || "";
            const gsInput = document.getElementById('googleSheetUrlInput');
            if (gsInput) gsInput.value = currentGoogleSheetUrl;
        });

        // Toggle admin button visibility if role is not manager
        const navAdmin = document.getElementById('navAdminBtn');
        if (navAdmin) {
            navAdmin.style.display = isAdmin ? 'block' : 'none';
        }

        // Attach listeners for this store
        attachStoreListeners();
        showTab('tables');
    }

    function attachStoreListeners() {
        // Detach existing listeners if any
        if (attachedListeners.length > 0) {
            attachedListeners.forEach(l => {
                try { l.ref.off('value', l.fn); } catch(e){}
            });
            attachedListeners = [];
        }

        function registerListener(ref, fn) {
            ref.on('value', fn);
            attachedListeners.push({ ref: ref, fn: fn });
        }

        // RegCode
        registerListener(storeRef('settings/regCode'), s => {
            currentRegCode = s.val() || "Chưa có";
            const el = document.getElementById('displayRegCode');
            if (el) el.innerText = currentRegCode;
        });

        // Devices
        registerListener(storeRef('devices'), s => {
            allDevicesData = s.val() || {};
            renderDevicesList(allDevicesData);
            checkDeviceAuth(allDevicesData);
            updateTasksViewDropdown();
        });

        // Menu
        registerListener(storeRef('menu'), s => {
            menuData = s.val() || {};
            renderMenu();
            renderAdminMenu();
        });

        // Tables
        registerListener(storeRef('tables'), s => {
            tablesData = s.val() || {};
            renderTables();
            if (curTable) renderBill();
        });

        // Active shift
        registerListener(storeRef('active_shift'), s => {
            currentShift = s.val();
            updateShiftUI();
            renderActiveBills();
        });

        // Edit logs
        registerListener(storeRef('edit_logs'), s => {
            renderEditHistory();
        });

        // QR URL
        registerListener(storeRef('settings/qrUrl'), s => {
            qrUrl = s.val() || "";
            const input = document.getElementById('qrUrlInput');
            if (input) input.value = qrUrl;
            updateQRDisplay();
        });

        // Kitchen Print
        registerListener(storeRef('settings/kitchenOrderPrint'), s => {
            const val = s.val();
            if (val !== null && val !== undefined) {
                isKitchenPrintEnabled = (val === true);
            }
            localStorage.setItem('uc_kitchen_print_enabled', isKitchenPrintEnabled ? 'true' : 'false');
            updateKitchenPrintUI();
        });

        // Shift logs when needed
        if (shiftLogsListenerAttached) {
            registerListener(storeRef('shift_logs'), s => {
                renderShiftLogs(s.val());
                filterStats();
            });
        }
    }

    function checkDeviceAuth(devices) {
        if (isAdmin) return;
        const myDevId = localStorage.getItem('uc_dev_id');
        const myDevPass = localStorage.getItem('uc_dev_pass');

        if (!myDevId || !devices[myDevId] || devices[myDevId].password !== myDevPass) {
            showPortalOverlay();
        } else {
            hidePortalOverlay();
        }
    }

    function getUserRole() {
        if (isAdmin) return "Quản lý";
        const sessionStr = localStorage.getItem('uc_session');
        if (sessionStr) {
            try {
                const session = JSON.parse(sessionStr);
                if (session.role === 'Quản lý' || session.isOwner) return "Quản lý";
            } catch(e){}
        }
        const myDevId = localStorage.getItem('uc_dev_id');
        if (myDevId && allDevicesData[myDevId]) {
            return allDevicesData[myDevId].role || "Phục vụ";
        }
        return "Phục vụ";
    }

    function renderDevicesList(devices) {
        const list = document.getElementById('deviceList');
        if (!list) return;
        list.innerHTML = '';
        if(Object.keys(devices).length === 0) {
            list.innerHTML = '<p style="color:gray; font-size:13px; text-align:center;">Chưa có thiết bị nào đăng ký.</p>';
            return;
        }
        Object.keys(devices).forEach(key => {
            const dev = devices[key];
            const currentRole = dev.role || 'Phục vụ';
            list.innerHTML += `
                <div class="dev-item">
                    <div>
                        <b style="font-size:14px; color:var(--dark);">👤 ${dev.name}</b><br>
                        <span style="color:gray; font-size:11px;">SĐT: ${dev.phone || 'N/A'} | Ngày tạo: ${dev.createdAt}</span><br>
                        <select onchange="updateDeviceRole('${key}', this.value)" style="margin-top:8px; padding:6px; font-size:12px; border-radius:6px; font-weight:bold; border:1px solid #ddd;">
                            <option value="Phục vụ" ${currentRole === 'Phục vụ' ? 'selected' : ''}>Phục vụ (Không thể tính tiền)</option>
                            <option value="Thu ngân" ${currentRole === 'Thu ngân' ? 'selected' : ''}>Thu ngân (Được tính tiền)</option>
                            <option value="Quản lý" ${currentRole === 'Quản lý' ? 'selected' : ''}>Quản lý (Có mọi quyền)</option>
                        </select>
                    </div>
                    <button onclick="deleteDevice('${key}')" style="background:var(--danger); color:white; border:none; padding:8px 15px; border-radius:8px; font-weight:bold; font-size:11px; cursor:pointer;">XOÁ</button>
                </div>
            `;
        });
    }

    function updateDeviceRole(key, newRole) {
        storeRef('devices/' + key).update({ role: newRole }).then(() => {
            alert("Đã cập nhật quyền thành công!");
        });
    }

    function deleteDevice(key) {
        if (confirm("Xoá tài khoản này? Thiết bị của nhân viên này sẽ lập tức bị văng ra trang đăng nhập.")) {
            storeRef('devices/' + key).remove();
        }
    }

    function generateNewCode() {
        const newCode = Math.floor(10000 + Math.random() * 90000).toString();
        if(confirm("Tạo mã đăng ký mới? (Mã cũ sẽ không còn hiệu lực)")) {
            storeRef('settings/regCode').set(newCode);
        }
    }

    function copyCode() {
        if(currentRegCode === "Chưa có") return alert("Hãy tạo mã mới trước!");
        navigator.clipboard.writeText(currentRegCode).then(() => {
            alert("Đã sao chép mã: " + currentRegCode);
        }).catch(err => {
            alert("Lỗi sao chép, bạn có thể tự bôi đen và copy.");
        });
    }

    function logEditHistory(actionType, details, reason, table) {
        let staffName = "Admin";
        const myDevId = localStorage.getItem('uc_dev_id');
        if (myDevId && allDevicesData && allDevicesData[myDevId] && allDevicesData[myDevId].name) {
            staffName = allDevicesData[myDevId].name;
        }
        const logData = {
            timestamp: new Date().toLocaleString('vi-VN'),
            time: new Date().toLocaleTimeString('vi-VN'),
            date: new Date().toLocaleDateString('vi-VN'),
            action: actionType,
            details: details,
            reason: reason || "Không có lý do",
            table: table || "N/A",
            staff: staffName
        };
        storeRef('edit_logs').push(logData);
        if (currentShift) {
            storeRef('active_shift/edit_history').push(logData);
        }
    }

    function renderEditHistory() {
        const list = document.getElementById('editHistoryList');
        if (!list) return;
        storeRef('edit_logs').once('value', snapshot => {
            const data = snapshot.val();
            if (!data) {
                list.innerHTML = '<div style="color:gray; font-size:13px; text-align:center; padding:15px; background:#f9f9f9; border-radius:8px;">Chưa có lịch sử sửa / xóa nào.</div>';
                return;
            }
            let html = '';
            const entries = Object.values(data).reverse();
            entries.forEach(item => {
                html += `
                    <div style="background:#ffffff; border:1px solid #e0e0e0; border-left:4px solid var(--danger); border-radius:8px; padding:10px 12px; margin-bottom:8px; font-size:12px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; font-weight:bold; color:var(--dark); margin-bottom:4px;">
                            <span>⚠️ ${item.action} ${item.table ? '(Bàn ' + item.table + ')' : ''}</span>
                            <span style="color:#777; font-weight:normal; font-size:11px;">🕒 ${item.timestamp || item.time}</span>
                        </div>
                        <div style="color:#333; margin-bottom:4px; font-size:12px;">${item.details}</div>
                        <div style="background:#fff3cd; color:#856404; padding:5px 8px; border-radius:5px; font-weight:bold; margin-top:4px;">
                            💬 Lý do: ${item.reason}
                        </div>
                        <div style="color:#888; font-size:11px; margin-top:4px; text-align:right;">
                            👤 Thao tác: <b>${item.staff || 'N/A'}</b>
                        </div>
                    </div>
                `;
            });
            list.innerHTML = html;
        });
    }

    function deleteActiveTableBill() {
        if (!curTable) return alert("Chưa chọn bàn!");
        
        // Ràng buộc quyền quản lý mới được xóa tổng bill
        const role = getUserRole();
        if (role !== 'Quản lý') {
            return alert("Chỉ có tài khoản Quản lý mới có quyền xóa tổng hóa đơn!");
        }

        const tableData = tablesData[curTable];
        const items = tableData?.items || [];
        if (!items || items.length === 0) {
            return alert("Bàn " + curTable + " chưa có món nào trong bill!");
        }

        const total = items.reduce((sum, it) => sum + (it.price * it.qty), 0);
        const totalQty = items.reduce((sum, it) => sum + it.qty, 0);

        const reason = prompt("Nhập lý do xóa/hủy toàn bộ hóa đơn Bàn " + curTable + ":");
        if (reason === null) return;
        if (!reason.trim()) {
            return alert("Vui lòng nhập lý do để xóa bill!");
        }

        logEditHistory("Xóa toàn bộ hóa đơn", `Xóa hóa đơn Bàn ${curTable} (${totalQty} món, tổng ${total.toLocaleString()}đ)`, reason.trim(), curTable);

        storeRef('tables/' + curTable).remove().then(() => {
            alert("Đã xóa hóa đơn Bàn " + curTable);
            closeTableOrderView();
            renderTables();
        }).catch(err => {
            alert("Lỗi khi xóa hóa đơn: " + err.message);
        });
    }

    function formatQRDisplayUrl(url) {
        if (!url) return "";
        if (url.includes('drive.google.com')) {
            let fileId = url.split('/d/')[1]?.split('/')[0];
            if (fileId) return `https://drive.google.com/thumbnail?id=${fileId}&sz=w500`;
        }
        return url;
    }

    function updateQRDisplay() {
        let displayUrl = formatQRDisplayUrl(qrUrl);
        const imgEl = document.getElementById('qrDisplay');
        if (imgEl) {
            imgEl.src = displayUrl;
            imgEl.style.display = (payMethod === 'transfer' && displayUrl) ? 'block' : 'none';
        }
    }

    storeRef('settings/qrUrl').on('value', s => {
        qrUrl = s.val() || "";
        document.getElementById('qrUrlInput').value = qrUrl;
        updateQRDisplay();
    });

    let isKitchenPrintEnabled = localStorage.getItem('uc_kitchen_print_enabled') !== 'false';

    function updateKitchenPrintUI() {
        const statusText = document.getElementById('kitchenPrintStatusText');
        const btnToggle = document.getElementById('btnToggleKitchenPrint');
        if (!statusText || !btnToggle) return;

        if (isKitchenPrintEnabled) {
            statusText.innerText = "ĐANG BẬT IN (ON)";
            statusText.style.color = "var(--success)";
            btnToggle.innerText = "BẬT (ON)";
            btnToggle.style.background = "var(--success)";
        } else {
            statusText.innerText = "ĐANG CHẶN IN (OFF)";
            statusText.style.color = "var(--danger)";
            btnToggle.innerText = "TẮT (OFF)";
            btnToggle.style.background = "var(--danger)";
        }
    }

    storeRef('settings/kitchenOrderPrint').on('value', s => {
        const val = s.val();
        if (val !== null && val !== undefined) {
            isKitchenPrintEnabled = (val === true);
        }
        localStorage.setItem('uc_kitchen_print_enabled', isKitchenPrintEnabled ? 'true' : 'false');
        updateKitchenPrintUI();
    });

    // --- APP STARTUP & PERSISTED SESSION RESTORATION ---
    window.addEventListener('DOMContentLoaded', () => {
        updateKitchenPrintUI();
        const savedSession = localStorage.getItem('uc_session');
        if (savedSession) {
            try {
                const session = JSON.parse(savedSession);
                if (session && session.storeId) {
                    applySession(session);
                    return;
                }
            } catch (e) {
                console.error("Lỗi đọc session:", e);
            }
        }
        // First time access: show portal overlay for role selection
        showPortalOverlay();
        selectPortalRole('store');
        setPortalMode('login');
    });

    function toggleKitchenPrint() {
        isKitchenPrintEnabled = !isKitchenPrintEnabled;
        localStorage.setItem('uc_kitchen_print_enabled', isKitchenPrintEnabled ? 'true' : 'false');
        updateKitchenPrintUI();
        storeRef('settings/kitchenOrderPrint').set(isKitchenPrintEnabled);
    }

    let shiftLogsListenerAttached = false;
    function loadShiftLogsData() {
        if (!shiftLogsListenerAttached) {
            shiftLogsListenerAttached = true;
            storeRef('shift_logs').on('value', s => { renderShiftLogs(s.val()); filterStats(); });
        }
    }

    function accessAdmin() {
        const role = getUserRole();
        if (role !== "Quản lý" && !isAdmin) {
            alert("Chỉ tài khoản quản lý / chủ cửa hàng mới có quyền mở mục Quản lý!");
            return;
        }
        isAdmin = true;
        const authOv = document.getElementById('authOverlay');
        if (authOv) authOv.style.display = 'none';
        loadShiftLogsData();
        showTab('admin');
    }

    function startShift() { storeRef('active_shift').set({start: new Date().toLocaleString('vi-VN'), revenue: 0, revenueCash: 0, revenueTransfer: 0}); }

    function endShift() {
        if(!currentShift) return alert("Không có ca nào đang mở!");
        if(confirm("Xác nhận CHỐT CA? Toàn bộ bàn sẽ được dọn trống và dữ liệu sẽ được xuất ra báo cáo Google Sheets.")) {
            let chiTietHoaDon = "";
            if (currentShift.history) {
                Object.values(currentShift.history).forEach((bill) => {
                    (bill.items || []).forEach(it => {
                        let thanhTienMon = it.price * it.qty;
                        chiTietHoaDon += `${it.fName} x${it.qty}  ${thanhTienMon.toLocaleString()}đ\n`;
                    });
                });
                chiTietHoaDon = chiTietHoaDon.trim();
            } else {
                chiTietHoaDon = "Không có đơn hàng";
            }

            const payload = {
                ngayThang: new Date().toLocaleDateString('vi-VN'),
                dienGiai: chiTietHoaDon,
                hinhThucThanhToan: `TM: ${(currentShift.revenueCash || 0).toLocaleString()}đ | CK: ${(currentShift.revenueTransfer || 0).toLocaleString()}đ`,
                soTien: currentShift.revenue || 0
            };

            const scriptUrl = (currentStoreData && currentStoreData.googleSheetUrl) || currentGoogleSheetUrl || "https://script.google.com/macros/s/AKfycby5W6tkb__SKAfpcUGXdDTjwKmWAS_vg02PM0993YcbNdrtQAqZZxK7FBbU0OM0Yht1/exec";

            if (scriptUrl && scriptUrl.trim()) {
                fetch(scriptUrl.trim(), {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                }).then(() => console.log("Đã gửi lệnh xuất Sheets")).catch(e => console.warn("Lỗi gửi Sheets: " + e));
            }

            const data = {
                start: currentShift.start, end: new Date().toLocaleTimeString('vi-VN'),
                date: new Date().toLocaleDateString('vi-VN'),
                revenue: currentShift.revenue || 0,
                revenueCash: currentShift.revenueCash || 0,
                revenueTransfer: currentShift.revenueTransfer || 0,
                timestamp: Date.now()
            };
            storeRef('shift_logs').push(data).then(() => {
                storeRef('active_shift').remove();
                storeRef('tables').remove();
                alert("Đã chốt ca thành công!");
            });
        }
    }

    function deleteShiftLog(key) { if(confirm("Bạn muốn xóa vĩnh viễn lịch sử ca này?")) storeRef('shift_logs/' + key).remove(); }

    function renderShiftLogs(logs) {
        const list = document.getElementById('shiftLogsList'); list.innerHTML = '';
        if(!logs) { list.innerHTML = '<p style="color:gray; text-align:center;">Chưa có ca nào được chốt.</p>'; return; }
        Object.keys(logs).reverse().forEach(key => {
            const log = logs[key];
            list.innerHTML += `<div class="shift-log-card"><div style="display:flex; justify-content:space-between;"><div><b style="color:var(--dark);">📅 ${log.date}</b><br><small style="color:gray;">🕒 ${log.start.split(',')[1] || log.start} - ${log.end}</small></div><button onclick="deleteShiftLog('${key}')" style="background:var(--danger); color:white; border:none; border-radius:6px; font-size:10px; padding:4px 8px; font-weight:bold;">XÓA</button></div><div style="font-size:12px; margin-top:8px; color:#555;">TM: ${(log.revenueCash||0).toLocaleString()} | CK: ${(log.revenueTransfer||0).toLocaleString()}</div><div style="color:var(--danger); font-weight:900; font-size:16px; margin-top:8px; border-top:1px dashed #eee; padding-top:8px;">Tổng: ${log.revenue.toLocaleString()}đ</div></div>`;
        });
    }

    function exportShiftLogs() {
        const role = getUserRole();
        if (role !== "Quản lý" && !isAdmin) {
            let pass = prompt("Nhập mật khẩu quản lý để tải dữ liệu lịch sử ca:");
            if (pass === null) return;
            if (pass !== "1905" && (!currentStoreData || pass !== currentStoreData.password)) {
                alert("Sai mật khẩu! Không thể tải dữ liệu.");
                return;
            }
        }

        storeRef('shift_logs').once('value').then(snapshot => {
            const logs = snapshot.val();
            if (!logs) {
                alert("Chưa có dữ liệu lịch sử ca nào để tải!");
                return;
            }

            let csvContent = "\uFEFF";
            csvContent += "Ngày,Giờ Mở Ca,Giờ Chốt Ca,Tiền Mặt,Chuyển Khoản,Tổng Doanh Thu\n";

            Object.values(logs).forEach(log => {
                let date = log.date || "";
                let start = (log.start || "").replace(/,/g, ' -');
                let end = (log.end || "").replace(/,/g, ' -');
                let cash = log.revenueCash || 0;
                let transfer = log.revenueTransfer || 0;
                let total = log.revenue || 0;

                csvContent += `${date},${start},${end},${cash},${total}\n`;
            });

            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement("a");
            const url = URL.createObjectURL(blob);
            link.setAttribute("href", url);
            link.setAttribute("download", `Lich_Su_Ca_UyenCoffee_${new Date().toLocaleDateString('vi-VN').replace(/\//g, '-')}.csv`);
            link.style.visibility = 'hidden';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }).catch(error => {
            alert("Lỗi khi lấy dữ liệu: " + error);
        });
    }

    function renderActiveBills() {
        const section = document.getElementById('activeBillSection');
        const list = document.getElementById('activeBillsList'); list.innerHTML = '';
        if(!currentShift || !currentShift.history) { section.style.display = 'none'; return; }
        section.style.display = 'block';
        Object.keys(currentShift.history).reverse().forEach(key => {
            const bill = currentShift.history[key];
            let staffDisplay = bill.payStaff ? ` | 💳 TT: <span style="color: var(--primary); font-weight: 800;">${bill.payStaff}</span>` : (bill.staff ? ` | 👤 ${bill.staff}` : '');
            let timeDetail = `Vào: ${bill.startTime || 'N/A'} - Ra: ${bill.payTime || bill.time || 'N/A'}`;
            let itemsHtml = (bill.items || []).map((it, idx) => {
                return `<div class="detail-item"><span><b>${it.qty}x</b> ${it.fName}</span><span>${(it.price * it.qty).toLocaleString()}đ <span style="color:var(--danger); cursor:pointer; font-weight:bold; margin-left:5px;" onclick="deleteItemInBill('${key}', ${idx})"> (X)</span></span></div>`;
            }).join('');
            list.innerHTML += `<div class="bill-history-card"><div style="margin-bottom:8px;"><b>Bàn ${bill.table} (${timeDetail})${staffDisplay} - <span style="color:${bill.method === 'transfer' ? 'var(--primary)' : 'var(--success)'}">${bill.method === 'transfer' ? '💳 CK' : '💵 TM'}</span></b><div style="float:right; display:flex; gap:5px;"><button style="color:white; background:var(--primary); border:none; border-radius:4px; font-weight:bold; padding:4px 8px; font-size:10px; cursor:pointer;" onclick="reprintBill('${key}')">IN LẠI</button><button style="color:white; background:var(--danger); border:none; border-radius:4px; font-weight:bold; padding:4px 8px; font-size:10px; cursor:pointer;" onclick="deleteBill('${key}')">XÓA</button></div></div>${itemsHtml}<div style="color:var(--primary); font-weight:900; margin-top:10px; border-top:1px solid #eee; padding-top:8px; font-size:15px;">Tổng: ${bill.total.toLocaleString()}đ</div></div>`;
        });
    }

    function deleteItemInBill(billKey, itemIdx) {
        // Ràng buộc quyền quản lý mới được xóa món trong bill đã thanh toán
        const role = getUserRole();
        if (role !== 'Quản lý') {
            return alert("Chỉ có tài khoản Quản lý mới có quyền xóa món khỏi hóa đơn đã thanh toán!");
        }

        if (!currentShift || !currentShift.history || !currentShift.history[billKey]) return;
        const bill = currentShift.history[billKey];
        const item = bill.items ? bill.items[itemIdx] : null;
        if (!item) return;
        const subAmount = (item.price * item.qty);
        const method = bill.method || 'cash';

        const reason = prompt("Nhập lý do xóa món " + item.fName + " khỏi bill đã thanh toán (Bàn " + bill.table + "):");
        if (reason === null) return;
        if (!reason.trim()) {
            return alert("Vui lòng nhập lý do để xóa món!");
        }

        logEditHistory("Xóa món khỏi bill đã thanh toán", `Xóa món ${item.fName} (${item.qty}x, ${subAmount.toLocaleString()}đ) khỏi bill Bàn ${bill.table}`, reason.trim(), bill.table);

        bill.items.splice(itemIdx, 1);
        let updates = {};
        updates['active_shift/history/' + billKey + '/items'] = bill.items;
        updates['active_shift/history/' + billKey + '/total'] = bill.total - subAmount;
        updates['active_shift/revenue'] = currentShift.revenue - subAmount;
        if(method === 'cash') updates['active_shift/revenueCash'] = (currentShift.revenueCash||0) - subAmount;
        else updates['active_shift/revenueTransfer'] = (currentShift.revenueTransfer||0) - subAmount;
        storeUpdate(updates);
    }

    function reprintBill(key) {
        if (!currentShift || !currentShift.history || !currentShift.history[key]) return;
        const bill = currentShift.history[key];

        let timeDetail = `Vào: ${bill.startTime || 'N/A'} - Ra: ${bill.payTime || bill.time || 'N/A'}`;
        let staffDisplay = bill.payStaff || bill.staff || "Admin";

        if (!confirm(`XÁC NHẬN IN LẠI HÓA ĐƠN?\n\n- Bàn: ${bill.table}\n- Thời gian: ${timeDetail}\n- Thu ngân: ${staffDisplay}\n- Tổng tiền: ${(bill.total || 0).toLocaleString()}đ\n\nBạn có chắc chắn muốn gửi lệnh in lại hóa đơn này không?`)) {
            return;
        }

        let receiptPayload = {
            type: 'receipt',
            isReprint: true,
            table: bill.table,
            items: bill.items || [],
            total: bill.total || 0,
            timestamp: Date.now(),
            printed: false,
            staffName: staffDisplay,
            staff: staffDisplay
        };

        storeRef('orders').push(receiptPayload).then(() => {
            alert("Đã gửi yêu cầu in lại hóa đơn Bàn " + bill.table + " thành công!");
        }).catch(err => {
            alert("Lỗi khi gửi yêu cầu in lại hóa đơn: " + err.message);
        });
    }

    function deleteBill(key) {
        // Ràng buộc quyền quản lý mới được xóa bill đã thanh toán
        const role = getUserRole();
        if (role !== 'Quản lý') {
            return alert("Chỉ có tài khoản Quản lý mới có quyền xóa hóa đơn đã thanh toán!");
        }

        if (!currentShift || !currentShift.history || !currentShift.history[key]) return;
        const bill = currentShift.history[key];
        const method = bill.method || 'cash';

        const reason = prompt("Nhập lý do xóa bill đã thanh toán (Bàn " + bill.table + " - " + bill.total.toLocaleString() + "đ):");
        if (reason === null) return;
        if (!reason.trim()) {
            return alert("Vui lòng nhập lý do để xóa bill!");
        }

        logEditHistory("Xóa bill đã thanh toán", `Xóa bill Bàn ${bill.table} (Tổng tiền: ${bill.total.toLocaleString()}đ)`, reason.trim(), bill.table);

        let updates = {};
        updates['active_shift/revenue'] = (currentShift.revenue || 0) - bill.total;
        if(method === 'cash') updates['active_shift/revenueCash'] = (currentShift.revenueCash||0) - bill.total;
        else updates['active_shift/revenueTransfer'] = (currentShift.revenueTransfer||0) - bill.total;
        updates['active_shift/history/' + key] = null;
        storeUpdate(updates);
    }

    function filterStats() {
        let from = document.getElementById('dateFrom').value, to = document.getElementById('dateTo').value;
        if(!from || !to) return;
        storeRef('shift_logs').once('value', s => {
            let total = 0;
            Object.values(s.val() || {}).forEach(log => {
                let p = log.date.split('/'), logD = `${p[2]}-${p[1].padStart(2,'0')}-${p[0].padStart(2,'0')}`;
                if(logD >= from && logD <= to) total += log.revenue;
            });
            document.getElementById('statFiltered').innerText = total.toLocaleString() + "đ";
        });
    }

    let currentTableSubTab = 'tables';

    function hasUnconfirmedItems() {
        if (!curTable || !tablesData[curTable]) return false;
        let items = tablesData[curTable].items || [];
        return items.some(it => !it.sent);
    }

    function switchTableSubTab(sub) {
        if (curTable && hasUnconfirmedItems()) {
            alert("Vui lòng bấm XÁC NHẬN đơn hàng trước khi chuyển tab!");
            return;
        }
        currentTableSubTab = sub;
        const btnTables = document.getElementById('subtab-btn-tables');
        const btnBills = document.getElementById('subtab-btn-bills');
        if (sub === 'tables') {
            btnTables.style.borderBottom = '3px solid var(--primary)';
            btnTables.style.color = 'var(--primary)';
            btnBills.style.borderBottom = 'none';
            btnBills.style.color = '#666';
        } else {
            btnBills.style.borderBottom = '3px solid var(--primary)';
            btnBills.style.color = 'var(--primary)';
            btnTables.style.borderBottom = 'none';
            btnTables.style.color = '#666';
        }
        closeTableOrderView();
        renderTables();
    }

    function closeTableOrderView(force = false) {
        if (!force && curTable && hasUnconfirmedItems()) {
            alert("Vui lòng bấm XÁC NHẬN đơn hàng trước khi thoát ra khỏi bàn!");
            return false;
        }
        document.getElementById('table-order-view').style.display = 'none';
        document.getElementById('list-tables').style.display = 'grid';
        document.getElementById('table-subtabs').style.display = 'flex';
        curTable = null;
        return true;
    }

    function renderTables() {
        const container = document.getElementById('list-tables'); container.innerHTML = '';
        let countVisible = 0;

        for(let i=1; i<=40; i++) {
            let t = tablesData[i] || { status: 'white' };

            let tableTotal = 0;
            if(t.items && t.items.length > 0) {
                t.items.forEach(item => { tableTotal += item.price * item.qty; });
            }
            if (tableTotal === 0 && t.status !== 'white') {
                storeRef('tables/' + i).update({ status: 'white', items: null, startTime: null });
                t.status = 'white';
            }

            if (currentTableSubTab === 'bills' && tableTotal === 0) {
                continue;
            }
            countVisible++;

            let serveBoxHtml = `<div onclick="event.stopPropagation(); openServeModal(${i})" style="width: 85%; margin: 2px auto 6px auto; padding: 5px 2px; font-size: 9px; text-align: center; border-radius: 6px; cursor: pointer; transition: 0.2s; ${t.needsServing ? 'background: var(--danger-gradient); color: white; font-weight: bold; border: none; box-shadow: 0 2px 5px rgba(220,53,69,0.3);' : 'background: rgba(255,255,255,0.6); color: #888; border: 1px dashed rgba(0,0,0,0.1);'}">${t.needsServing ? 'CẦN BƯNG NƯỚC' : 'TRỐNG'}</div>`;

            let priceHtml = tableTotal > 0 ? `<div class="price-display" style="color:var(--danger); font-size:12px; font-weight:bold; margin-top:2px;">${tableTotal.toLocaleString()}đ</div>` : '';

            let timeText = t.startTime ? `${Math.floor((new Date()-new Date(t.startTime))/60000)}p` : '';
            let statusDisplay = (tableTotal > 0 ? '' : 'Trống') + (timeText ? ` - ${timeText}` : '');

            container.innerHTML += `<div class="table-card status-${t.status}" onclick="selectTable(${i})">
                <div style="font-size:16px; margin-bottom:4px;">🖨️</div>
                <span style="font-size:14px; font-weight:bold;">Bàn ${i}</span>
                ${priceHtml}
                <div class="table-timer timer-display" style="margin-top:2px; font-size:11px; background:none; padding:0; color:#666;">${statusDisplay}</div>
                ${serveBoxHtml}
            </div>`;
        }

        if (currentTableSubTab === 'bills' && countVisible === 0) {
            container.innerHTML = '<div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: gray; font-weight: bold;">Không có bàn nào đang có hóa đơn chưa thanh toán.</div>';
        }
    }

    let currentOrderSubView = 'menu';

    function selectTable(i) {
        if (curTable && curTable !== i && hasUnconfirmedItems()) {
            alert("Vui lòng bấm XÁC NHẬN đơn hàng trước khi chọn bàn khác!");
            return;
        }
        curTable = i;
        document.getElementById('orderHeaderTitle').innerText = "BÀN " + i + " - MENU";
        document.getElementById('list-tables').style.display = 'none';
        document.getElementById('table-subtabs').style.display = 'none';
        document.getElementById('table-order-view').style.display = 'flex';

        if (currentTableSubTab === 'bills') {
            setOrderSubView('bill');
        } else {
            setOrderSubView('menu');
        }

        renderBill();
    }

    function setOrderSubView(view) {
        currentOrderSubView = view;
        const menuSec = document.getElementById('menu-section-flex');
        const billSec = document.getElementById('bill-section-part');
        const btnToggle = document.getElementById('btnToggleOrderView');
        const headerTitle = document.getElementById('orderHeaderTitle');

        if (view === 'bill') {
            menuSec.style.display = 'none';
            billSec.style.display = 'flex';
            btnToggle.innerText = '← CHỌN MÓN';
            headerTitle.innerText = "BÀN " + curTable + " - HOÁ ĐƠN";
        } else {
            menuSec.style.display = 'flex';
            billSec.style.display = 'none';
            btnToggle.innerText = 'Xem đơn >';
            headerTitle.innerText = "BÀN " + curTable + " - MENU";
        }
    }

    function toggleOrderSubView() {
        if (currentOrderSubView === 'menu') {
            setOrderSubView('bill');
        } else {
            setOrderSubView('menu');
        }
    }

    function renderMenu() {
        const m = document.getElementById('list-menu');
        const sb = document.getElementById('category-sidebar');
        m.innerHTML = ''; sb.innerHTML = '';

        let grouped = {};
        Object.values(menuData).forEach(it => {
            let cat = it.category || 'Khác';
            if(!grouped[cat]) grouped[cat] = [];
            grouped[cat].push(it);
        });

        Object.keys(grouped).forEach(cat => {
            grouped[cat].sort((a, b) => {
                let aSold = a.soldOut ? 1 : 0;
                let bSold = b.soldOut ? 1 : 0;
                return bSold - aSold;
            });
        });

        sb.innerHTML += `<div class="cat-btn active" onclick="scrollToCat('cat-all', this)">Tất cả</div>`;

        let isFirst = true;
        for (let cat in grouped) {
            let catId = "cat-" + cat.replace(/\s+/g, '-').toLowerCase();

            sb.innerHTML += `<div class="cat-btn" onclick="scrollToCat('${catId}', this)">${cat}</div>`;

            let headerAttr = isFirst ? 'id="cat-all"' : '';
            isFirst = false;

            m.innerHTML += `<div ${headerAttr} id="${catId}" class="cat-header">${cat}</div>`;

            grouped[cat].forEach(it => {
                let hasHC = it.hasHotCold !== false;
                let escapedName = (it.name || '').replace(/'/g, "\\'");
                if (it.soldOut) {
                    m.innerHTML += `<div class="menu-item sold-out"><div style="color:var(--dark); font-weight:bold; font-size:12px; line-height:1.2; width:100%; word-break:break-word;">${it.name}</div><span style="color:var(--danger); font-size:11px; font-weight:900; margin-top:2px; display:inline-block;">HẾT MÓN</span><span style="color:var(--primary); font-size: 12px; font-weight:bold; margin-top:2px; display:inline-block;">${it.price/1000}k</span></div>`;
                } else {
                    m.innerHTML += `<div class="menu-item" onclick="openOpt('${escapedName}', ${it.price}, ${hasHC})"><div style="color:var(--dark); font-weight:bold; font-size:12px; line-height:1.2; width:100%; word-break:break-word;">${it.name}</div><span style="color:var(--primary); font-size: 12px; font-weight:bold; margin-top:4px; display:inline-block;">${it.price/1000}k</span></div>`;
                }
            });
        }
    }

    function scrollToCat(catId, btn) {
        document.querySelectorAll('.cat-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        let el = document.getElementById(catId);
        if(el) {
            el.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
    }

    function checkShiftRequired() {
        if (!currentShift) {
            alert("Phải MỞ CA MỚI trong mục 'Cửa Hàng' thì mới có thể thực hiện gọi món và thanh toán!");
            return false;
        }
        return true;
    }

    function openOpt(name, price, hasHotCold = true) {
        if(!curTable) return alert("Chọn bàn!");
        if(!checkShiftRequired()) return;

        let isSoldOut = false;
        Object.values(menuData).forEach(item => {
            if(item.name === name && item.soldOut) isSoldOut = true;
        });
        if(isSoldOut) return alert("Món này đã hết, không thể gọi!");

        let staffName = "Admin";
        const myDevId = localStorage.getItem('uc_dev_id');
        if (myDevId && allDevicesData[myDevId] && allDevicesData[myDevId].name) {
            staffName = allDevicesData[myDevId].name;
        }

        if (!hasHotCold) {
            let items = tablesData[curTable]?.items || [];
            items.unshift({fName: name, price: price, qty: 1, done: false, sent: false, orderStaff: staffName});
            storeRef('tables/'+curTable).update({ items: items, startTime: tablesData[curTable]?.startTime || new Date().toLocaleTimeString('vi-VN'), status: tablesData[curTable]?.status === 'green' ? 'green' : 'white' });
            return;
        }

        tempItem = {name, price, staffName};
        document.getElementById('optTitle').innerText = name;
        document.getElementById('optModal').style.display = 'flex';
        updateOptUI();
    }

    function confirmAdd() {
        if(!checkShiftRequired()) return;
        let note = document.getElementById('optNote').value.trim();
        let fullName = `${tempItem.name} (${curType})${note ? ': ' + note : ''}`;
        let items = tablesData[curTable]?.items || [];
        items.unshift({fName: fullName, price: tempItem.price, qty: 1, done: false, sent: false, orderStaff: tempItem.staffName || "Admin"});
        storeRef('tables/'+curTable).update({ items: items, startTime: tablesData[curTable]?.startTime || new Date().toLocaleTimeString('vi-VN'), status: tablesData[curTable]?.status === 'green' ? 'green' : 'white' });

        document.getElementById('optNote').value = '';
        closeModal('optModal');
    }

    function renderBill() {
        const b = document.getElementById('billItems'); b.innerHTML = ''; let total = 0; let totalQty = 0;
        let items = tablesData[curTable]?.items || [];
        items.forEach((it, idx) => {
            total += it.price * it.qty;
            totalQty += it.qty;
            b.innerHTML += `<div class="bill-row" onclick="openQtyEdit(${idx})"><span class="${!it.done?'item-not-done':''}" style="font-size:14px; margin-bottom:4px;"><b style="color:var(--primary)">${it.qty}x</b> ${it.fName}</span><span style="color:#555; font-weight:bold;">${(it.price * it.qty).toLocaleString()}đ</span></div>`;
        });

        const totalFormatted = total.toLocaleString() + "đ";
        const tableSummaryText = `BÀN ${curTable || 1} (${totalQty} món)`;

        const lblSummary = document.getElementById('lblTableSummary');
        if (lblSummary) lblSummary.innerText = tableSummaryText;

        const lblTotalSum = document.getElementById('lblTotalSummary');
        if (lblTotalSum) lblTotalSum.innerText = totalFormatted;
    }

    function handleConfirm() { 
        if(!curTable) return; 

        let tableData = tablesData[curTable];
        let items = tableData?.items || [];

        items.forEach(it => {
            if (it.sent === undefined) it.sent = true;
        });

        let newItems = items.filter(it => it.sent === false);

        if (newItems.length === 0) {
            alert("Không có món mới nào cần xác nhận in!");
            return;
        }

        storeRef('tables/'+curTable).update({status: 'red'});

        let staffName = "Admin";
        const myDevId = localStorage.getItem('uc_dev_id');
        if (myDevId && allDevicesData[myDevId] && allDevicesData[myDevId].name) {
            staffName = allDevicesData[myDevId].name;
        }

        let preparedItems = newItems.map(it => ({
            ...it,
            printedItem: false
        }));

        if (isKitchenPrintEnabled) {
            let orderPayload = {
                type: 'kitchen',
                table: curTable,
                items: preparedItems,
                timestamp: Date.now(),
                printed: false,
                staffName: staffName,
                staff: staffName
            };
            storeRef('orders').push(orderPayload);
        }

        items.forEach(it => {
            it.sent = true;
        });

        storeRef('tables/' + curTable + '/items').set(items).then(() => {
            closeTableOrderView(); 
            renderTables(); 
        });
    }

    function setStatus(s) {
        if(!curTable) return;
        if(hasUnconfirmedItems()) {
            alert("Vui lòng bấm XÁC NHẬN đơn hàng trước khi bấm XONG HẾT!");
            return;
        }
        let items = tablesData[curTable].items || [];
        items.forEach(it => it.done = true);
        storeRef('tables/'+curTable).update({items: items, status: s});
        closeTableOrderView(true);
        renderTables();
    }

    function openPayModal() {
        if(!curTable || !tablesData[curTable]) return;
        if(!checkShiftRequired()) return;

        if(hasUnconfirmedItems()) {
            alert("Vui lòng bấm XÁC NHẬN đơn hàng trước khi thanh toán!");
            return;
        }

        const role = getUserRole();
        if (role === 'Phục vụ') {
            alert("Tài khoản của bạn có quyền phục vụ, không thể thực hiện chức năng thanh toán!");
            return;
        }

        const total = parseInt(document.getElementById('lblTotalSummary').innerText.replace(/\D/g,'')) || 0;
        document.getElementById('payTotal').innerText = total.toLocaleString() + "đ";
        document.getElementById('payModal').style.display = 'flex';
        setPayMethod('cash');
    }

    function handlePay(shouldPrint) {
        if(!checkShiftRequired()) return;
        const total = parseInt(document.getElementById('payTotal').innerText.replace(/\D/g,''));

        let staffName = "Admin";
        const myDevId = localStorage.getItem('uc_dev_id');
        if (myDevId && allDevicesData[myDevId] && allDevicesData[myDevId].name) {
            staffName = allDevicesData[myDevId].name;
        }

        let tableInfo = tablesData[curTable] || {};
        let startTimeDisplay = tableInfo.startTime ? (tableInfo.startTime.includes('T') ? new Date(tableInfo.startTime).toLocaleTimeString('vi-VN') : tableInfo.startTime) : new Date().toLocaleTimeString('vi-VN');
        let payTimeDisplay = new Date().toLocaleTimeString('vi-VN');

        const billData = {
            time: payTimeDisplay,
            startTime: startTimeDisplay,
            payTime: payTimeDisplay,
            table: curTable,
            total: total,
            method: payMethod,
            items: tableInfo.items || [],
            payStaff: staffName
        };

        let updates = {};
        updates['active_shift/history/' + Date.now()] = billData;
        updates['active_shift/revenue'] = (currentShift.revenue||0) + total;
        if(payMethod === 'cash') updates['active_shift/revenueCash'] = (currentShift.revenueCash||0) + total;
        else updates['active_shift/revenueTransfer'] = (currentShift.revenueTransfer||0) + total;
        
        storeUpdate(updates);

        if (shouldPrint) {
            let receiptPayload = {
                type: 'receipt', 
                table: curTable,
                items: tableInfo.items || [],
                total: total,
                timestamp: Date.now(),
                printed: false,
                staffName: staffName,
                staff: staffName
            };
            storeRef('orders').push(receiptPayload);
        }

        storeRef('tables/'+curTable).remove();
        closeModal('payModal'); 
        closeTableOrderView(); 
        renderTables(); 
    }

    function printTempBill() {
        if (!curTable) return alert("Chưa chọn bàn!");
        const tableInfo = tablesData[curTable] || {};
        const items = tableInfo.items || [];
        if (items.length === 0) {
            return alert("Bàn " + curTable + " chưa có món nào để in tạm tính!");
        }

        let staffName = "Admin";
        const myDevId = localStorage.getItem('uc_dev_id');
        if (myDevId && allDevicesData && allDevicesData[myDevId] && allDevicesData[myDevId].name) {
            staffName = allDevicesData[myDevId].name;
        }

        let total = 0;
        items.forEach(it => { total += (it.price * it.qty); });

        let receiptPayload = {
            type: 'receipt',
            isTemp: true,
            table: curTable,
            items: items,
            total: total,
            timestamp: Date.now(),
            printed: false,
            staffName: staffName,
            staff: staffName
        };

        storeRef('orders').push(receiptPayload).then(() => {
            alert("Đã gửi yêu cầu in tạm tính Bàn " + curTable + " thành công!");
        }).catch(err => {
            alert("Lỗi khi gửi yêu cầu in tạm tính: " + err.message);
        });
    }

    function openQtyEdit(idx) {
        editIdx = idx; let it = tablesData[curTable].items[idx];
        document.getElementById('qtyName').innerText = it.fName;
        document.getElementById('qtyVal').innerText = it.qty;
        document.getElementById('editItemNote').value = it.note || '';
        const btnDone = document.getElementById('btnItemDone');
        if (btnDone) {
            if (it.done) {
                btnDone.innerText = 'ĐÃ XONG';
                btnDone.style.background = 'var(--success-gradient)';
            } else {
                btnDone.innerText = 'XONG';
                btnDone.style.background = 'var(--dark)';
            }
        }
        document.getElementById('qtyModal').style.display = 'flex';
    }
    function changeQty(v) { let q = parseInt(document.getElementById('qtyVal').innerText) + v; if(q >= 0) document.getElementById('qtyVal').innerText = q; }

    function saveItemEdit() {
        if (curTable === null || editIdx === null) return;
        let items = tablesData[curTable].items || [];
        if (!items[editIdx]) return;

        let item = items[editIdx];
        let oldQty = item.qty || 1;
        let newQty = parseInt(document.getElementById('qtyVal').innerText) || 0;
        let addedNote = document.getElementById('editItemNote').value.trim();

        // YÊU CẦU 2: Chỉ món nào đã xác nhận/đã in (sent === true) khi xóa hoặc giảm mới cần nhập lý do
        if (item.sent && newQty < oldQty) {
            let isDelete = (newQty === 0);
            let promptMsg = isDelete ? `Nhập lý do xóa món ${item.fName}:` : `Nhập lý do giảm số lượng món ${item.fName} (${oldQty}x ➔ ${newQty}x):`;
            let reason = prompt(promptMsg);
            if (reason === null) return;
            if (!reason.trim()) {
                alert("Vui lòng nhập lý do!");
                return;
            }
            let actionTitle = isDelete ? "Xóa món" : "Giảm số lượng món";
            let detailsStr = isDelete ? `Xóa món ${item.fName} (SL cũ: ${oldQty}x) khỏi Bàn ${curTable}` : `Giảm món ${item.fName} từ ${oldQty}x ➔ ${newQty}x ở Bàn ${curTable}`;
            logEditHistory(actionTitle, detailsStr, reason.trim(), curTable);
        }

        if (newQty === 0) {
            items.splice(editIdx, 1);
            if (items.length === 0) {
                storeRef('tables/' + curTable).remove().then(() => {
                    closeModal('qtyModal');
                    renderBill();
                    renderTables();
                });
                return;
            } else {
                storeRef('tables/' + curTable).update({ items: items }).then(() => {
                    closeModal('qtyModal');
                    renderBill();
                });
                return;
            }
        }

        function applyNote(it, note) {
            it.note = note;
            if (note) {
                if (it.fName.includes(': ')) {
                    it.fName = it.fName.split(': ')[0] + ': ' + note;
                } else {
                    it.fName += `: ${note}`;
                }
            }
        }

        if (item.done) {
            if (newQty > oldQty) {
                applyNote(item, addedNote);
                let newItem = {
                    fName: item.fName,
                    price: item.price,
                    qty: newQty - oldQty,
                    done: false,
                    sent: false,
                    note: addedNote,
                    orderStaff: item.orderStaff || "Admin"
                };
                items.splice(editIdx + 1, 0, newItem);
            } else {
                item.qty = newQty;
                applyNote(item, addedNote);
                item.done = false;
            }
        } else {
            item.qty = newQty;
            applyNote(item, addedNote);
            item.done = false;
        }

        storeRef('tables/' + curTable).update({ items: items }).then(() => {
            closeModal('qtyModal');
            renderBill();
        });
    }

    function toggleItemDone() {
        if (curTable === null || editIdx === null) return;
        let items = tablesData[curTable].items || [];
        if (!items[editIdx]) return;

        let item = items[editIdx];
        let oldQty = item.qty || 1;
        let newQty = parseInt(document.getElementById('qtyVal').innerText) || 0;
        let addedNote = document.getElementById('editItemNote').value.trim();

        // YÊU CẦU 2: Chỉ món đã xác nhận (sent === true) mới cần nhập lý do khi giảm/xóa
        if (item.sent && newQty < oldQty) {
            let isDelete = (newQty === 0);
            let promptMsg = isDelete ? `Nhập lý do xóa món ${item.fName}:` : `Nhập lý do giảm số lượng món ${item.fName} (${oldQty}x ➔ ${newQty}x):`;
            let reason = prompt(promptMsg);
            if (reason === null) return;
            if (!reason.trim()) {
                alert("Vui lòng nhập lý do!");
                return;
            }
            let actionTitle = isDelete ? "Xóa món" : "Giảm số lượng món";
            let detailsStr = isDelete ? `Xóa món ${item.fName} (SL cũ: ${oldQty}x) khỏi Bàn ${curTable}` : `Giảm món ${item.fName} từ ${oldQty}x ➔ ${newQty}x ở Bàn ${curTable}`;
            logEditHistory(actionTitle, detailsStr, reason.trim(), curTable);
        }

        if (newQty === 0) {
            items.splice(editIdx, 1);
            if (items.length === 0) {
                storeRef('tables/' + curTable).remove().then(() => {
                    closeModal('qtyModal');
                    renderBill();
                    renderTables();
                });
                return;
            } else {
                storeRef('tables/' + curTable).update({ items: items }).then(() => {
                    closeModal('qtyModal');
                    renderBill();
                });
                return;
            }
        }

        item.qty = newQty;
        item.note = addedNote;
        if (addedNote) {
            if (item.fName.includes(': ')) {
                item.fName = item.fName.split(': ')[0] + ': ' + addedNote;
            } else {
                item.fName += `: ${addedNote}`;
            }
        }
        item.done = !item.done;

        storeRef('tables/' + curTable).update({ items: items }).then(() => {
            closeModal('qtyModal');
            renderBill();
        });
    }

    function openMoveTable() {
        if(!curTable) return;
        currentMoveMode = 'move';
        updateMoveModeUI();
        const sel = document.getElementById('selectToTable'); sel.innerHTML = '';
        for(let i=1; i<=40; i++) if(i != curTable) sel.innerHTML += `<option value="${i}">Bàn ${i}</option>`;
        document.getElementById('moveFrom').innerText = curTable;
        document.getElementById('moveTableModal').style.display = 'flex';
    }

    function setMoveMode(mode) {
        currentMoveMode = mode;
        updateMoveModeUI();
    }

    function updateMoveModeUI() {
        document.getElementById('modeMoveBtn').className = currentMoveMode === 'move' ? 'opt-btn active' : 'opt-btn';
        document.getElementById('modeMergeBtn').className = currentMoveMode === 'merge' ? 'opt-btn active' : 'opt-btn';
        document.getElementById('moveModalTitle').innerText = currentMoveMode === 'move' ? 'Chuyển bàn' : 'Gộp bàn';
    }

    function handleMoveOrMergeTable() {
        let targetTable = parseInt(document.getElementById('selectToTable').value);
        let sourceTable = curTable;
        if (!sourceTable || !targetTable) return;

        let sourceData = tablesData[sourceTable] || {};
        let targetData = tablesData[targetTable] || {};

        if (currentMoveMode === 'move') {
            storeRef('tables/' + targetTable).set(sourceData).then(() => {
                storeRef('tables/' + sourceTable).remove();
                closeModal('moveTableModal');
                closeTableOrderView(true);
                renderTables();
            });
        } else {
            let sourceItems = sourceData.items || [];
            let targetItems = targetData.items || [];

            let mergedItems = targetItems.concat(sourceItems);
            let startTime = targetData.startTime || sourceData.startTime || new Date().toISOString();
            let status = (targetData.status === 'red' || sourceData.status === 'red') ? 'red' : (targetData.status || sourceData.status || 'white');
            let needsServing = targetData.needsServing || sourceData.needsServing || false;

            storeRef('tables/' + targetTable).set({
                items: mergedItems,
                startTime: startTime,
                status: status,
                needsServing: needsServing
            }).then(() => {
                storeRef('tables/' + sourceTable).remove();
                closeModal('moveTableModal');
                closeTableOrderView(true);
                renderTables();
            });
        }
    }

    function setPayMethod(m) {
        payMethod = m;
        document.getElementById('payCashBtn').className = m==='cash'?'opt-btn active':'opt-btn';
        document.getElementById('payTransferBtn').className = m==='transfer'?'opt-btn active':'opt-btn';
        document.getElementById('cashSection').style.display = m==='cash'?'block':'none';
        document.getElementById('transferSection').style.display = m==='transfer'?'block':'none';
        updateQRDisplay();
    }

    function updateShiftUI() {
        const s = document.getElementById('shiftSummary');
        if(currentShift) {
            let staffRevenue = {};
            if (currentShift.history) {
                Object.values(currentShift.history).forEach(bill => {
                    let staffName = bill.payStaff || bill.staff || "Chưa xác định";
                    if (!staffRevenue[staffName]) {
                        staffRevenue[staffName] = { total: 0, cash: 0, transfer: 0 };
                    }
                    let amt = bill.total || 0;
                    staffRevenue[staffName].total += amt;
                    if (bill.method === 'transfer') {
                        staffRevenue[staffName].transfer += amt;
                    } else {
                        staffRevenue[staffName].cash += amt;
                    }
                });
            }

            let staffBreakdownHtml = "";
            Object.keys(staffRevenue).forEach(staff => {
                let stat = staffRevenue[staff];
                staffBreakdownHtml += `<div style="font-size:14px; font-weight:bold; color:var(--dark); margin-top:4px;">
                    • ${staff} : <span style="color:var(--dark);">${stat.total.toLocaleString()}đ</span>
                    <span style="font-size:12px; font-weight:normal; color:#555;">(💵 TM: <b style="color:var(--success);">${stat.cash.toLocaleString()}đ</b> | 💳 CK: <b style="color:var(--primary);">${stat.transfer.toLocaleString()}đ</b>)</span>
                </div>`;
            });

            if (!staffBreakdownHtml) {
                staffBreakdownHtml = `<div style="font-size:13px; color:gray; margin-top:3px;">Chưa có doanh thu theo nhân viên</div>`;
            }

            s.innerHTML = `Mở lúc: ${currentShift.start}<br>💵 TM: <b style="color:var(--success);">${(currentShift.revenueCash||0).toLocaleString()}đ</b> | 💳 CK: <b style="color:var(--primary);">${(currentShift.revenueTransfer||0).toLocaleString()}đ</b><br><br><b>Doanh thu theo nhân viên:</b><br>${staffBreakdownHtml}<br>Tổng doanh thu: <b style="color:var(--danger); font-size:20px; display:inline-block; margin-top:8px;">${(currentShift.revenue||0).toLocaleString()}đ</b>`;
            document.getElementById('btnOpen').style.display='none'; document.getElementById('btnClose').style.display='block';
        } else { s.innerText = "Chưa mở ca"; document.getElementById('btnOpen').style.display='block'; document.getElementById('btnClose').style.display='none'; }
    }

    function saveQR() {
        let u1 = document.getElementById('qrUrlInput').value.trim();
        storeRef('settings').update({
            qrUrl: u1
        }).then(() => alert("Đã lưu link ảnh QR thanh toán mặc định!"));
    }

    function saveGoogleSheetUrl() {
        let url = document.getElementById('googleSheetUrlInput').value.trim();
        currentGoogleSheetUrl = url;
        if (currentStoreData) currentStoreData.googleSheetUrl = url;
        Promise.all([
            db.ref('settings/stores/' + currentStoreId).update({ googleSheetUrl: url }),
            storeRef('settings').update({ googleSheetUrl: url })
        ]).then(() => {
            alert("Đã lưu link Google Sheet thành công!");
        }).catch(err => {
            alert("Lỗi lưu link Google Sheet: " + err.message);
        });
    }

    function showTab(id) {
        if (curTable && hasUnconfirmedItems()) {
            alert("Vui lòng bấm XÁC NHẬN đơn hàng trước khi chuyển trang!");
            return;
        }
        currentTab = id;
        document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.m-btn').forEach(b => b.classList.remove('active'));
        const tabEl = document.getElementById('tab-'+id);
        if(tabEl) tabEl.classList.add('active');
        if(document.getElementById('btn-tab-'+id)) document.getElementById('btn-tab-'+id).classList.add('active');

        if(id === 'tables') {
            closeTableOrderView(true);
            renderTables();
        } else if(id === 'pos') {
            showTab('tables');
        } else if(id === 'tasks') {
            initTasksTab();
        }
    }

    function closeModal(id) { document.getElementById(id).style.display='none'; }
    function updateOptUI() { document.getElementById('optNong').className = curType==='Nóng'?'opt-btn active':'opt-btn'; document.getElementById('optDa').className = curType==='Đá'?'opt-btn active':'opt-btn'; }
    function calcChange() { let t = parseInt(document.getElementById('payTotal').innerText.replace(/\D/g,'')), c = parseInt(document.getElementById('cashIn').value)||0; document.getElementById('cashChange').innerText = (c-t>0?(c-t).toLocaleString():0)+"đ"; }

    function addMenu() {
        const n = document.getElementById('inName').value;
        const p = parseInt(document.getElementById('inPrice').value);
        const c = document.getElementById('inCategory').value || 'Khác';
        const hc = document.getElementById('inHasHotCold').checked;
        if(n && p) {
            storeRef('menu').push({name:n, price:p, category: c, hasHotCold: hc, soldOut: false});
            document.getElementById('inName').value='';
            document.getElementById('inPrice').value='';
            document.getElementById('inCategory').value='';
            document.getElementById('inHasHotCold').checked = true;
        }
    }

    function renderAdminMenu() {
        const d = document.getElementById('adminMenu'); d.innerHTML = '';
        Object.keys(menuData).forEach(k => {
            let item = menuData[k];
            let cat = item.category || 'Khác';
            let isSoldOut = item.soldOut || false;
            let hcText = item.hasHotCold !== false ? ' (Có Nóng/Đá)' : ' (Không Nóng/Đá)';

            d.innerHTML += `<div style="display:flex; justify-content:space-between; align-items:center; padding:10px; border-bottom:1px solid #eee; background: white; margin-bottom: 5px; border-radius: 8px;">
                <div>
                    <b>${item.name}</b> ${isSoldOut ? '<span style="color:var(--danger); font-size:11px;">(Đã báo hết)</span>' : ''}<br>
                    <small style="color:gray;">Nhóm: ${cat} - ${item.price.toLocaleString()}đ ${hcText}</small>
                </div>
                <div style="display:flex; gap:5px;">
                    <button onclick="toggleSoldOut('${k}', ${!isSoldOut})" style="color:white; background:${isSoldOut ? 'var(--success)' : 'var(--warning)'}; border:none; border-radius:6px; padding:6px 10px; font-weight:bold; font-size:11px;">${isSoldOut ? 'Mở lại' : 'Báo hết'}</button>
                    <button onclick="openEditMenu('${k}')" style="color:white; background:var(--dark); border:none; border-radius:6px; padding:6px 10px; font-weight:bold; font-size:11px;">Sửa</button>
                    <button onclick="storeRef('menu/${k}').remove()" style="color:white; background:var(--danger); border:none; border-radius:6px; padding:6px 10px; font-weight:bold; font-size:11px;">Xóa</button>
                </div>
            `;
        });
    }

    function toggleSoldOut(key, status) {
        storeRef('menu/' + key).update({ soldOut: status });
    }

    function openEditMenu(key) {
        let item = menuData[key];
        document.getElementById('editMenuKey').value = key;
        document.getElementById('editMenuName').value = item.name;
        document.getElementById('editMenuPrice').value = item.price;
        document.getElementById('editMenuCategory').value = item.category || 'Khác';
        document.getElementById('editMenuHasHotCold').checked = item.hasHotCold !== false;
        document.getElementById('editMenuModal').style.display = 'flex';
    }

    function saveEditMenu() {
        let key = document.getElementById('editMenuKey').value;
        let n = document.getElementById('editMenuName').value;
        let p = parseInt(document.getElementById('editMenuPrice').value);
        let c = document.getElementById('editMenuCategory').value || 'Khác';
        let hc = document.getElementById('editMenuHasHotCold').checked;
        if(n && p) {
            storeRef('menu/' + key).update({name: n, price: p, category: c, hasHotCold: hc}).then(() => {
                closeModal('editMenuModal');
            });
        } else {
            alert("Vui lòng nhập đủ Tên và Giá!");
        }
    }

    let activeTaskListenerRef = null;

    function initTasksTab() {
        const role = getUserRole();

        if (role === 'Quản lý') {
            document.getElementById('managerTaskArea').style.display = 'block';
            document.getElementById('employeeTaskArea').style.display = 'none';
            updateTasksViewDropdown();
            loadTasksForManager();
        } else {
            document.getElementById('managerTaskArea').style.display = 'none';
            document.getElementById('employeeTaskArea').style.display = 'block';
            loadTasksForEmployee();
        }
    }

    function updateTasksViewDropdown() {
        const select = document.getElementById('taskEmployeeSelect');
        if (!select) return;
        const currentSelected = select.value;
        select.innerHTML = '';

        Object.keys(allDevicesData).forEach(key => {
            select.innerHTML += `<option value="${key}">👤 ${allDevicesData[key].name} (${allDevicesData[key].role || 'Phục vụ'})</option>`;
        });

        if (currentSelected && allDevicesData[currentSelected]) {
            select.value = currentSelected;
        }
    }

    function loadTasksForManager() {
        const targetEmployeeKey = document.getElementById('taskEmployeeSelect').value;
        const container = document.getElementById('managerTaskListContainer');
        container.innerHTML = '';

        if(activeTaskListenerRef) activeTaskListenerRef.off();
        if(!targetEmployeeKey) {
            container.innerHTML = '<p style="color:gray; text-align:center; font-size:13px;">Vui lòng chọn hoặc đăng ký nhân viên trước.</p>';
            return;
        }

        activeTaskListenerRef = storeRef('tasks/' + targetEmployeeKey);
        activeTaskListenerRef.on('value', s => {
            const tasks = s.val() || {};

            let hasUpdates = false;
            let updates = {};
            Object.keys(tasks).forEach(taskId => {
                let t = tasks[taskId];
                if (t.frequency > 0 && t.done && t.dueDate && Date.now() > t.dueDate) {
                    updates[`${taskId}/done`] = false;
                    let nextDue = t.dueDate;
                    while (nextDue < Date.now()) nextDue += t.frequency * 86400000;
                    updates[`${taskId}/dueDate`] = nextDue;
                    hasUpdates = true;
                }
            });

            if (hasUpdates) {
                storeRef('tasks/' + targetEmployeeKey).update(updates);
                return;
            }

            container.innerHTML = '';
            if(Object.keys(tasks).length === 0) {
                container.innerHTML = '<p style="color:gray; text-align:center; font-size:13px;">Nhân viên này chưa có việc nào được giao.</p>';
                return;
            }

            Object.keys(tasks).forEach(taskId => {
                const task = tasks[taskId];
                let textClass = 'task-text';

                let isOverdue = task.dueDate && Date.now() > task.dueDate && !task.done;
                if(task.important || isOverdue) textClass += ' task-important';
                if(task.done) textClass += ' task-done-text';

                let extraBadge = isOverdue ? `<span style="color:var(--danger); font-size:11px; margin-left:5px; font-weight:bold;">(Quá hạn)</span>` : '';

                container.innerHTML += `
                    <div class="task-card">
                        <div style="display:flex; align-items:center; gap:12px;">
                            <input type="checkbox" ${task.done ? 'checked' : ''} disabled style="width:20px; height:20px; accent-color: var(--primary);">
                            <span class="${textClass}">${task.text} ${extraBadge}</span>
                        </div>
                        <button onclick="deleteTaskByManager('${targetEmployeeKey}', '${taskId}')" style="background:var(--danger-gradient); color:white; border:none; padding:6px 12px; border-radius:6px; font-size:11px; font-weight:bold; cursor:pointer;">XÓA</button>
                    </div>
                `;
            });
        });
    }

    function addTaskByManager() {
        const targetEmployeeKey = document.getElementById('taskEmployeeSelect').value;
        const content = document.getElementById('taskContentInput').value.trim();
        const isImportant = document.getElementById('taskImportantInput').checked;
        const freq = parseInt(document.getElementById('taskFrequency').value);

        if(!targetEmployeeKey) return alert("Chưa chọn nhân viên nhận việc!");
        if(!content) return alert("Vui lòng điền nội dung công việc!");

        let dueDate = 0;
        if (freq > 0) {
            let d = new Date();
            d.setHours(23, 59, 59, 999);
            dueDate = d.getTime() + ((freq - 1) * 86400000);
        }

        storeRef('tasks/' + targetEmployeeKey).push({
            text: content,
            important: isImportant,
            frequency: freq,
            dueDate: dueDate,
            done: false,
            assignedAt: new Date().toLocaleString('vi-VN')
        }).then(() => {
            document.getElementById('taskContentInput').value = '';
            document.getElementById('taskImportantInput').checked = false;
            document.getElementById('taskFrequency').value = '0';
        });
    }

    function deleteTaskByManager(employeeKey, taskId) {
        if(confirm("Bạn có chắc chắn muốn xóa bỏ công việc này?")) {
            storeRef(`tasks/${employeeKey}/${taskId}`).remove();
        }
    }

    function openTransferTaskModal() {
        const targetId = document.getElementById('taskEmployeeSelect').value;
        if(!targetId) return alert("Vui lòng đăng ký và chọn nhân viên sẽ NHẬN việc trước!");

        document.getElementById('transferTargetName').innerText = allDevicesData[targetId].name;

        const sourceSelect = document.getElementById('transferSourceSelect');
        sourceSelect.innerHTML = '<option value="">-- Chọn nhân viên để lấy việc --</option>';

        Object.keys(allDevicesData).forEach(key => {
            if (key !== targetId) {
                sourceSelect.innerHTML += `<option value="${key}">${allDevicesData[key].name}</option>`;
            }
        });

        document.getElementById('transferTaskModal').style.display = 'flex';
    }

    function executeTaskTransfer() {
        const targetId = document.getElementById('taskEmployeeSelect').value;
        const sourceId = document.getElementById('transferSourceSelect').value;

        if(!sourceId) return alert("Vui lòng chọn nhân viên nguồn!");

        storeRef('tasks/' + sourceId).once('value').then(snapshot => {
            const sourceTasks = snapshot.val();
            if(!sourceTasks) {
                alert("Nhân viên này không có công việc nào để chuyển!");
                return;
            }

            if(confirm(`Xác nhận chuyển toàn bộ việc? Việc của nhân viên cũ sẽ bị xóa hết.`)) {
                let updates = {};

                Object.keys(sourceTasks).forEach(taskId => {
                    let newKey = storeRef(`tasks/${targetId}`).push().key;
                    updates[`tasks/${targetId}/${newKey}`] = sourceTasks[taskId];
                    updates[`tasks/${sourceId}/${taskId}`] = null;
                });

                storeUpdate(updates).then(() => {
                    alert("Chuyển việc thành công!");
                    closeModal('transferTaskModal');
                    loadTasksForManager();
                });
            }
        });
    }

    function loadTasksForEmployee() {
        const myDevId = localStorage.getItem('uc_dev_id');
        const container = document.getElementById('employeeTaskListContainer');
        container.innerHTML = '';

        if(activeTaskListenerRef) activeTaskListenerRef.off();
        if(!myDevId) return;

        activeTaskListenerRef = storeRef('tasks/' + myDevId);
        activeTaskListenerRef.on('value', s => {
            const tasks = s.val() || {};

            let hasUpdates = false;
            let updates = {};
            Object.keys(tasks).forEach(taskId => {
                let t = tasks[taskId];
                if (t.frequency > 0 && t.done && t.dueDate && Date.now() > t.dueDate) {
                    updates[`${taskId}/done`] = false;
                    let nextDue = t.dueDate;
                    while (nextDue < Date.now()) nextDue += t.frequency * 86400000;
                    updates[`${taskId}/dueDate`] = nextDue;
                    hasUpdates = true;
                }
            });

            if (hasUpdates) {
                storeRef('tasks/' + myDevId).update(updates);
                return;
            }

            container.innerHTML = '';
            if(Object.keys(tasks).length === 0) {
                container.innerHTML = '<div style="text-align:center; padding:30px 10px; background:white; border-radius:15px; box-shadow:0 4px 10px rgba(0,0,0,0.05);"><h3 style="color:var(--success); margin:0 0 10px 0;">🎉 Tuyệt vời!</h3><p style="color:gray; font-size:14px; margin:0;">Bạn không có việc nào cần xử lý lúc này.</p></div>';
                return;
            }

            Object.keys(tasks).forEach(taskId => {
                const task = tasks[taskId];
                let textClass = 'task-text';

                let isOverdue = task.dueDate && Date.now() > task.dueDate && !task.done;
                if(task.important || isOverdue) textClass += ' task-important';
                if(task.done) textClass += ' task-done-text';

                let extraBadge = isOverdue ? `<span style="color:var(--danger); font-size:11px; margin-left:5px; font-weight:bold;">(Quá hạn)</span>` : '';

                container.innerHTML += `
                    <div class="task-card" style="justify-content: flex-start; gap:15px; padding:18px;">
                        <input type="checkbox" ${task.done ? 'checked' : ''} onchange="toggleTaskStatus('${taskId}', this.checked, ${task.dueDate || 0}, ${task.frequency || 0})" style="width:24px; height:24px; cursor:pointer; accent-color: var(--primary);">
                        <span class="${textClass}">${task.text} ${extraBadge}</span>
                    </div>
                `;
            });
        });
    }

    function toggleTaskStatus(taskId, isChecked, currentDueDate, freq) {
        const myDevId = localStorage.getItem('uc_dev_id');
        if(!myDevId) return;

        let updates = { done: isChecked };

        if (isChecked && freq > 0 && currentDueDate > 0 && Date.now() > currentDueDate) {
            let d = new Date();
            d.setHours(23, 59, 59, 999);
            updates.dueDate = d.getTime();
        }

        storeRef(`tasks/${myDevId}/${taskId}`).update(updates);
    }

    let targetServeTable = null;

    function openServeModal(tableId) {
        targetServeTable = tableId;
        document.getElementById('serveTableId').innerText = tableId;
        document.getElementById('serveModal').style.display = 'flex';
    }

    function setServeStatus(needsServing) {
        if(!targetServeTable) return;
        storeRef('tables/' + targetServeTable).update({ needsServing: needsServing }).then(() => {
            closeModal('serveModal');
        });
    }

    document.addEventListener("visibilitychange", function() {
        if (document.visibilityState === 'hidden') {
            firebase.database().goOffline();
        } else {
            firebase.database().goOnline();
        }
    });

</script>
</body>
</html>
